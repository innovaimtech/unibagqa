if($_REQUEST["subexec"] == "save")
{
   foreach(array_keys($_REQUEST) AS $reqkey)
   {
      if(strpos($reqkey, "fab_item_id_") !== false && strpos($reqkey, "fab_item_id_") == 0)
      {
         if((int)$_REQUEST[$reqkey])
         {
            $idxarr              = explode("_", $reqkey);
            $fab_type            = $idxarr[3];
            $posidx              = $idxarr[4];
            $fab_item_id         = (int)$_REQUEST[$reqkey];
            $fab_desc            = trim(addslashes($_REQUEST["fab_desc_{$fab_type}_{$posidx}"]));
            $fab_med_width       = (int)trim($_REQUEST["fab_med_width_{$fab_type}_{$posidx}"]);
            $fab_med_height      = (int)trim($_REQUEST["fab_med_height_{$fab_type}_{$posidx}"]);
            $fab_med_fuelle      = (int)trim($_REQUEST["fab_med_fuelle_{$fab_type}_{$posidx}"]);
            $fab_min_amt         = getPrice(trim($_REQUEST["fab_min_amt_{$fab_type}_{$posidx}"]));
            $fab_corte_machine   = (int)trim($_REQUEST["fab_corte_machine_{$fab_type}_{$posidx}"]);
            $fab_roll_width      = (int)trim($_REQUEST["fab_roll_width_{$fab_type}_{$posidx}"]);
            $fab_fabric_gr       = (int)trim($_REQUEST["fab_fabric_gr_{$fab_type}_{$posidx}"]);
            $fab_manilla_length  = (int)trim($_REQUEST["fab_manilla_length_{$fab_type}_{$posidx}"]);
            $fab_print_width     = (int)trim($_REQUEST["fab_print_width_{$fab_type}_{$posidx}"]);
            $fab_print_height    = (int)trim($_REQUEST["fab_print_height_{$fab_type}_{$posidx}"]);
            $fab_noprint_discount = (int)trim($_REQUEST["fab_noprint_discount_{$fab_type}_{$posidx}"]);
            $fab_active          = (int)$_REQUEST["fab_active_{$fab_type}_{$posidx}"];
            $fab_inc_id          = (int)$_REQUEST["fab_inc_id_{$fab_type}_{$posidx}"];
            $existingid          = (int)$_REQUEST["existingid_{$fab_type}_{$posidx}"];

            $prc_headerid = $existingid;
            if((int)$existingid)
            {
               $sql = " update price_lists_fab_items
                        set
                        fab_item_id          = {$fab_item_id},   
                        fab_type             = '{$fab_type}',
                        fab_desc             = '{$fab_desc}',
                        fab_med_width        = {$fab_med_width},
                        fab_med_height       = {$fab_med_height},
                        fab_med_fuelle       = {$fab_med_fuelle},
                        fab_min_amt          = {$fab_min_amt},
                        fab_corte_machine    = {$fab_corte_machine},
                        fab_roll_width       = {$fab_roll_width},
                        fab_fabric_gr        = {$fab_fabric_gr},
                        fab_manilla_length   = {$fab_manilla_length},
                        fab_print_width      = {$fab_print_width},
                        fab_print_height     = {$fab_print_height},
                        fab_noprint_discount = {$fab_noprint_discount},
                        fab_active           = {$fab_active},
                        fab_inc_id           = {$fab_inc_id}
                        where
                        id = {$existingid}";
               $res = $CON->no_result($sql);

               $sql = " delete from price_lists_fab_items_prices
                        where
                        pl_id = {$_REQUEST["id"]} and
                        prc_headerid = {$existingid}";
               $CON->no_result($sql);
            }
            else
            {
            
               $sql = " insert into price_lists_fab_items
                        (pl_id, fab_item_id, fab_type, fab_desc, fab_med_width, fab_med_height, fab_med_fuelle,
                         fab_min_amt, fab_corte_machine, fab_roll_width, fab_fabric_gr, fab_manilla_length,
                         fab_print_width, fab_print_height, fab_noprint_discount, fab_active, fab_inc_id)
                        VALUES
                        ({$_REQUEST["id"]}, {$fab_item_id}, '{$fab_type}', '{$fab_desc}', {$fab_med_width},
                         {$fab_med_height}, {$fab_med_fuelle}, {$fab_min_amt}, {$fab_corte_machine}, {$fab_roll_width},
                         {$fab_fabric_gr}, {$fab_manilla_length}, {$fab_print_width}, {$fab_print_height},
                         {$fab_noprint_discount}, {$fab_active}, {$fab_inc_id})";
               $res = $CON->no_result($sql);

               if($res)
                  $prc_headerid = mysql_insert_id();
            }
            if($res)
            {
               foreach(array_keys($_REQUEST) AS $reqkey)
               {
                  if(strpos($reqkey, "prc_price_{$fab_type}_{$posidx}_") !== false && strpos($reqkey, "prc_price_{$fab_type}_{$posidx}_") == 0)
                  {
                     $idxarr     = explode("_", $reqkey);
                     $prc_amount = (int)$idxarr[4];
                     $prc_price  = getPrice($_REQUEST[$reqkey]);

                     if($prc_amount > 0.00 && $prc_price > 0.00)
                     {
                        $sql = " insert into price_lists_fab_items_prices
                                 (prc_headerid, pl_id, prc_amount, prc_price)
                                 VALUES
                                 ({$prc_headerid}, {$_REQUEST["id"]}, {$prc_amount}, {$prc_price})";
                        $CON->no_result($sql);
                     }
                     else
                     {
                        $sql = " delete from price_lists_fab_items_prices
                                 where
                                 pl_id          = {$_REQUEST["id"]} and
                                 prc_headerid   = {$prc_headerid} and
                                 prc_amount     = {$prc_amount}";
                        $CON->no_result($sql);
                     }
                  }
               }
            }
         }
         else
         {
            $idxarr     = explode("_", $reqkey);
            $fab_type   = $idxarr[3];
            $posidx     = $idxarr[4];
            $existingid = (int)$_REQUEST["existingid_{$fab_type}_{$posidx}"];

            if((int)$existingid)
            {
               $sql = " delete from price_lists_fab_items
                        where
                        pl_id = {$_REQUEST["id"]} and
                        id = {$existingid}";
               $CON->no_result($sql);

               $sql = " delete from price_lists_fab_items_prices
                        where
                        pl_id = {$_REQUEST["id"]} and
                        prc_headerid = {$existingid}";
               $CON->no_result($sql);
            }
         }
      }
   }
   
   $savemsg = getSaveMessage(true);
}

