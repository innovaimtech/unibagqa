if((int)$_REQUEST["clonexec"])
{
   $sql = " insert into orders
            (
               req_desc, req_desc_intern, req_number, req_company_id, req_shop_id, req_cust_id,
               req_hash, req_status, req_total_netto, req_total_taxes, req_total_brutto,
               req_crtdat, req_crtusr, req_upddat, req_updusr, req_paymentid,
               req_userid_seller, req_userid_cashing, req_invoiced, req_order_shipped,
               req_cust_delivid, req_transportid, req_taxes, req_weightprice_netto, req_oc_number,
               req_oc_dat, req_discount_perc, req_discount_amt, req_discount_amount_netto,
               req_isinvcbrutto, req_custnameprov, req_isreserva, req_crtdat_first, req_isfabricate,
               req_offerid, req_despacho_desc, req_trazlogoprice_netto, req_embalaje_desc, req_pie_imprenta,
               req_isfabricate_extern, req_design_blocked_uid, req_production_act, req_production_initdate
            )
            select req_desc, req_desc_intern, req_number, req_company_id, req_shop_id, req_cust_id,
                   req_hash, req_status, req_total_netto, req_total_taxes, req_total_brutto,
                   req_crtdat, req_crtusr, req_upddat, req_updusr, req_paymentid,
                   req_userid_seller, req_userid_cashing, req_invoiced, req_order_shipped,
                   req_cust_delivid, req_transportid, req_taxes, req_weightprice_netto, req_oc_number,
                   req_oc_dat, req_discount_perc, req_discount_amt, req_discount_amount_netto,
                   req_isinvcbrutto, req_custnameprov, req_isreserva, req_crtdat_first, req_isfabricate,
                   req_offerid, req_despacho_desc, req_trazlogoprice_netto, req_embalaje_desc, req_pie_imprenta,
                   req_isfabricate_extern, req_design_blocked_uid, req_production_act, req_production_initdate
            from orders
            where
            id = {$_REQUEST["id"]}";
   $res = $CON->no_result($sql);
   if($res)
   {
      $neworderid = mysql_insert_id();

      $sql = " select *
               from orders
               where
               id = {$neworderid}";
      $neworder = $CON->select($sql);
      $neworder = $neworder[0];

      if(!(int)$neworder["req_isfabricate"])
         $req_num = createTransactionNumber($CON, $neworder["req_company_id"], "invoice");
      else
         $req_num  = createInternalAltaNumberOrder($CON, 1);
         
      $currtme  = time();
      $sql = " update orders
               set
               req_status              = 1,
               req_number              = '{$req_num}',
               req_crtdat_first        = {$currtme},
               req_crtdat              = {$currtme},
               req_crtusr              = {$_SESSION["user_id"]},
               req_upddat              = 0,
               req_updusr              = 0,
               req_hash                = '',
               req_production_act      = 0,
               req_production_initdate = 0,
               req_invoiced            = 0,
               req_order_shipped       = 0,
               req_oc_number           = '',
               req_oc_dat              = 0
               where
               id = {$neworderid}";
      $CON->no_result($sql);

      $sql = " insert into orders_items
               (
                  req_id,
                  item_id, item_pos, item_amount, item_amount_shipped, item_type, item_sellprice_brutto,
                  item_sellprice_taxes_perc, item_sellprice_netto, item_sellprice_netto_dsc,
                  item_sellprice_brutto_dsc, item_sellprice_taxes, item_discount, item_discount_type,
                  item_pcat_dsc_act, item_pcat_dsc1, item_pcat_dsctype1, item_pcat_dsc2, item_pcat_dsctype2,
                  item_pcat_dsc3, item_pcat_dsctype3, item_pcat_dsc4, item_pcat_dsctype4, item_vol_act,
                  item_vol_dsc, item_vol_dsctype, item_value_act, item_value_dsc, item_value_dsctype,
                  item_desc, item_promid, item_promdsc, item_amount_shipped_stop, item_order_genamount,
                  item_amount_shipped_comment, item_compdesc, item_img_hash, fab_type, fab_printtype,
                  fab_med_width, fab_med_height, fab_med_fuelle, fab_print_width, fab_print_height,
                  fab_manilla_length, fab_mat_fabric_color, fab_mat_manilla_color, fab_print_colors_front_1,
                  fab_print_colors_back_1, fab_print_colors_front_2, fab_print_colors_back_2,
                  fab_print_colors_front_3, fab_print_colors_back_3, fab_print_colors_front_4,
                  fab_print_colors_back_4, fab_print_colors_front_5, fab_print_colors_back_5,
                  fab_print_colordesc_1, fab_print_colordesc_2, fab_print_colordesc_3, fab_print_colordesc_4,
                  fab_print_colordesc_5, fab_design_imagehash, fab_design_desc, item_sellprice_trazado,
                  item_sellprice_barcode, item_sellprice_barcodenumber, fab_mat_gramms
               )
               select '{$neworderid}' AS 'req_id',
                      item_id, item_pos, item_amount, item_amount_shipped, item_type, item_sellprice_brutto,
                      item_sellprice_taxes_perc, item_sellprice_netto, item_sellprice_netto_dsc,
                      item_sellprice_brutto_dsc, item_sellprice_taxes, item_discount, item_discount_type,
                      item_pcat_dsc_act, item_pcat_dsc1, item_pcat_dsctype1, item_pcat_dsc2, item_pcat_dsctype2,
                      item_pcat_dsc3, item_pcat_dsctype3, item_pcat_dsc4, item_pcat_dsctype4, item_vol_act,
                      item_vol_dsc, item_vol_dsctype, item_value_act, item_value_dsc, item_value_dsctype,
                      item_desc, item_promid, item_promdsc, item_amount_shipped_stop, item_order_genamount,
                      item_amount_shipped_comment, item_compdesc, item_img_hash, fab_type, fab_printtype,
                      fab_med_width, fab_med_height, fab_med_fuelle, fab_print_width, fab_print_height,
                      fab_manilla_length, fab_mat_fabric_color, fab_mat_manilla_color, fab_print_colors_front_1,
                      fab_print_colors_back_1, fab_print_colors_front_2, fab_print_colors_back_2,
                      fab_print_colors_front_3, fab_print_colors_back_3, fab_print_colors_front_4,
                      fab_print_colors_back_4, fab_print_colors_front_5, fab_print_colors_back_5,
                      fab_print_colordesc_1, fab_print_colordesc_2, fab_print_colordesc_3, fab_print_colordesc_4,
                      fab_print_colordesc_5, fab_design_imagehash, fab_design_desc, item_sellprice_trazado,
                      item_sellprice_barcode, item_sellprice_barcodenumber, fab_mat_gramms
               from orders_items
               where
               req_id = {$_REQUEST["id"]}";
      $CON->no_result($sql);

      $sql = " select *
               from orders_items
               where
               req_id = {$neworderid}";
      $temppos = $CON->select($sql);
      foreach($temppos AS $tempposrow)
      {
         $item_img_hash = "";
         $fab_design_imagehash = "";
         if($tempposrow["item_img_hash"] != "")
         {
            $doc_dir  = "{$_SESSION["_CONF"]["conf_shopadmin_path"]}docs.offer/";
            $doc_file = $doc_dir.$tempposrow["item_img_hash"];
            
            $item_img_hash = "{$neworderid}_".$tempposrow["item_img_hash"];
            copy($doc_file, $doc_dir.$item_img_hash);
         }
         if($tempposrow["fab_design_imagehash"] != "")
         {
            $doc_dir  = "{$_SESSION["_CONF"]["conf_shopadmin_path"]}docs.order/";
            $doc_file = $doc_dir.$tempposrow["fab_design_imagehash"];
            
            $fab_design_imagehash = "{$neworderid}_".$tempposrow["fab_design_imagehash"];
            copy($doc_file, $doc_dir.$fab_design_imagehash);
         }
         
         $sql = " update orders_items
                  set
                  item_amount_shipped  = 0,
                  item_img_hash        = '{$item_img_hash}',
                  fab_design_imagehash = '{$fab_design_imagehash}'
                  where
                  req_id      = {$tempposrow["req_id"]} and
                  item_id     = {$tempposrow["item_id"]} and
                  item_pos    = {$tempposrow["item_pos"]}";
         $CON->no_result($sql);
                  
      }
      ?>
      <script language="JavaScript">
         alert('Folio <?=$req_num?> generado exitosamente.\nRedireccionando a la nueva CC...');
         location.href = '/index.php?mid=<?=$_REQUEST["mid"]?>&exec=edit&id=<?=$neworderid?>';
      </script>
      <?
      exit;
   }
}

