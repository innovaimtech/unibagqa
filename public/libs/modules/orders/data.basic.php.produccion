//----------------------------------------------------------------------------------
$payments   = getPayments($CON, $headdata["req_shop_id"]);
$sellers    = getSellers($CON);
$posdata    = getOrderPos($CON, $_REQUEST["id"], $_REQUEST["setPosOrder"]);
$transports = getTransports($CON);

//----------------------------------------------------------------------------------
$rowcount = 0;
if($posdata != false && count($posdata))
   $rowcount = count($posdata);

if($rowcount <= 6)
   $rowcount = 10;
else
   $rowcount += 5;

if($headdata["req_status"] >= 2)
{
   $rdlo       = " readonly ";
