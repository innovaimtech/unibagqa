//----------------------------------------------------------------------------------
if($_REQUEST["subexec"] == "prodinitsave" && (int)$_REQUEST["prodact"])
{
   $currtme = time();

   $_REQUEST["prd_plantaid"]  = (int)$_REQUEST["prd_plantaid"];
   $_REQUEST["prd_desc"]      = trim(addslashes($_REQUEST["prd_desc"]));

   $sql = " insert into prod_header
            (prd_crtdat, prd_crtusr, prd_status, prd_desc, prd_plantaid, prd_reqid)
            VALUES
            ({$currtme}, {$_SESSION["user_id"]}, 1, '{$_REQUEST["prd_desc"]}', {$_REQUEST["prd_plantaid"]},
             {$_REQUEST["id"]})";
   $res = $CON->no_result($sql);
   if($res)
   {
      $prodid = mysql_insert_id();
   
      foreach(array_keys($_REQUEST) AS $reqkey)
      {
         if(strpos($reqkey, "prodplan_amt_") !== false && strpos($reqkey, "prodplan_amt_") == 0)
         {
            $idx = substr($reqkey, strrpos($reqkey, "_") +1);

            $prodplan_amt  = getPrice($_REQUEST["prodplan_amt_{$idx}"]);
            $prodplan_date = trim($_REQUEST["prodplan_date_{$idx}"]);

            if($prodplan_amt > 0 && $prodplan_date != "")
            {
               $prodplan_date = explode(".", $prodplan_date);
               $prodplan_date = mktime(15, 0, 0, $prodplan_date[1], $prodplan_date[0], $prodplan_date[2]);
               $sql = " insert into prod_amtplan
                        (prodplan_amt, prodplan_date, prodplan_prdid)
                        VALUES
                        ({$prodplan_amt}, {$prodplan_date}, {$prodid})";
               $CON->no_result($sql);
            }
         }
      }

      $sql = " update orders
               set
               req_production_act = 1,
               req_production_initdate = {$currtme}
               where
               id = {$_REQUEST["id"]}";
      $res = $CON->no_result($sql);

      $_REQUEST['sendprodmail'] = 1;
   }

   $savemsg = getSaveMessage($res);
}

//----------------------------------------------------------------------------------
if($_REQUEST["subexec"] == "create")
{
   $currtme = time();

   $_REQUEST["cust_id_0"]     = (int)$_REQUEST["cust_id_0"];
   $_REQUEST["company_id"]    = (int)$_REQUEST["company_id"];
   $_REQUEST["shop_id"]       = (int)$_REQUEST["shop_id"];
   $_REQUEST["req_taxes"]     = (int)$_REQUEST["req_taxes"];
   $_REQUEST["req_isinvcbrutto"] = (int)$_REQUEST["req_isinvcbrutto"];
   $_REQUEST["req_isreserva"] = (int)$_REQUEST["req_isreserva"];
   $_REQUEST["order_id"]      = (int)$_REQUEST["order_id"];

   //----------------------------------------------------------------------------------
   $sql = " select t1.cust_paymentid, t1.cust_sellerid, t1.cust_transportid, t2.pay_days
            from customer t1
            LEFT OUTER JOIN payments t2 ON t1.cust_paymentid = t2.id
            where
            t1.id = {$_REQUEST["cust_id_0"]}";
   $custdata = $CON->select($sql);
   $custdata = $custdata[0];

   $req_userid_seller   = (int)$custdata["cust_sellerid"];
   $req_userid_cashing  = (int)$custdata["cust_sellerid"];
   $req_paymentid       = (int)$custdata["cust_paymentid"];
   $req_paymentdays     = (int)$custdata["pay_days"];
   $req_transportid     = (int)$custdata["cust_transportid"];

   //----------------------------------------------------------------------------------
   $_SELLRET = sellerHasReplacement($CON, $req_userid_seller, time());
   $seller_repluserid   = $_SELLRET["SELLER"];
   $cashing_repluserid  = $_SELLRET["CASHER"];

   //----------------------------------------------------------------------------------
   if((int)$seller_repluserid)
      $req_userid_seller = $seller_repluserid;
   if((int)$cashing_repluserid)
      $req_userid_cashing = $cashing_repluserid;

   //----------------------------------------------------------------------------------
   $req_num = createTransactionNumber($CON, $_REQUEST["company_id"], "invoice");

   //----------------------------------------------------------------------------------
   $sql = " insert into orders
            (req_number, req_company_id, req_shop_id, req_cust_id, req_paymentid, 
             req_userid_seller, req_userid_cashing, req_taxes, req_transportid,
             req_crtdat, req_crtusr, req_isinvcbrutto, req_isreserva, req_crtdat_first)
            VALUES
            ('{$req_num}', {$_REQUEST["company_id"]}, {$_REQUEST["shop_id"]}, {$_REQUEST["cust_id_0"]},
              {$req_paymentid}, {$req_userid_seller}, {$req_userid_cashing}, {$_REQUEST["req_taxes"]},
              {$req_transportid}, {$currtme}, {$_SESSION["user_id"]}, {$_REQUEST["req_isinvcbrutto"]},
              {$_REQUEST["req_isreserva"]}, {$currtme})";
   $res = $CON->no_result($sql);

   if($res)
   {
      $sql = " select MAX(id) 'thisid'
               from orders
               where
               req_crtusr = {$_SESSION["user_id"]}";
      $sorder = $CON->select($sql);
      $_REQUEST["id"]   = $sorder[0]["thisid"];

      if((int)$_REQUEST["order_id"])
      {
         $sql = " insert into orders_rels
                  (req_id_1, req_id_2)
                  VALUES
                  ({$_REQUEST["id"]}, {$_REQUEST["order_id"]})";
         $CON->no_result($sql);
      }

      ?>
      <script language="JavaScript">
         location.href = 'index.php?mid=689&exec=edit&id=<?=$_REQUEST["id"]?>'
      </script>
      <?
   }

   $savemsg = getSaveMessage($res);
}

//----------------------------------------------------------------------------------
if($_REQUEST["subexec"] == "save")
{
   $currtme = time();

   //----------------------------------------------------------------------------------
   $sql = " select *
            from orders
            where
            id = {$_REQUEST["id"]}";
   $headdata = $CON->select($sql);
   $headdata = $headdata[0];

   $_REQUEST["order_id"] = (int)$_REQUEST["order_id"];
   if((int)$_REQUEST["order_id"] && $_REQUEST["order_id"] != $_REQUEST["id"])
   {
      $sql = " insert into orders_rels
               (req_id_1, req_id_2)
               VALUES
               ({$_REQUEST["id"]}, {$_REQUEST["order_id"]})";
      $CON->no_result($sql);
   }
   
   //----------------------------------------------------------------------------------
   $_REQUEST["req_desc"]            = trim(addslashes($_REQUEST["req_desc"]));
   $_REQUEST["req_desc_intern"]     = trim(addslashes($_REQUEST["req_desc_intern"]));
   $_REQUEST["req_number"]          = trim(addslashes($_REQUEST["req_number"]));
   $_REQUEST["req_crtdat"]          = trim(addslashes($_REQUEST["req_crtdat"]));
   $_REQUEST["req_custnameprov"]    = trim(addslashes($_REQUEST["req_custnameprov"]));
   $_REQUEST["req_paymentid"]       = (int)$_REQUEST["req_paymentid"];
   $_REQUEST["req_userid_seller"]   = (int)$_REQUEST["req_userid_seller"];
   $_REQUEST["req_userid_cashing"]  = (int)$_REQUEST["req_userid_cashing"];
   $_REQUEST["req_transportid"]     = (int)$_REQUEST["req_transportid"];
   $_REQUEST["req_cust_delivid"]    = (int)$_REQUEST["req_cust_delivid"];
   $_REQUEST["req_isreserva"]       = (int)$_REQUEST["req_isreserva"];
   $_REQUEST["req_cust_aviso_months"] = (int)$_REQUEST["req_cust_aviso_months"];
   $_REQUEST["req_despacho_desc"]   = trim(addslashes($_REQUEST["req_despacho_desc"]));
   $_REQUEST["req_oc_dat"]          = trim(addslashes($_REQUEST["req_oc_dat"]));
   $_REQUEST["req_oc_number"]       = trim(addslashes($_REQUEST["req_oc_number"]));
   $_REQUEST["req_embalaje_desc"]   = trim(addslashes($_REQUEST["req_embalaje_desc"]));
   $_REQUEST["req_pie_imprenta"]    = trim(addslashes($_REQUEST["req_pie_imprenta"]));
   $_REQUEST["req_discount_perc"]   = getPrice($_REQUEST["req_discount_perc"],2);
   $_REQUEST["req_discount_amt"]    = getPrice($_REQUEST["req_discount_amt"]);

   //----------------------------------------------------------------------------------
   $_REQUEST["req_crtdat"] = explode(".", $_REQUEST["req_crtdat"]);
   $_REQUEST["req_crtdat"] = (int)mktime(date('H'), date('i'), date('s'), $_REQUEST["req_crtdat"][1], $_REQUEST["req_crtdat"][0], $_REQUEST["req_crtdat"][2]);
   $_REQUEST["req_oc_dat"] = explode(".", $_REQUEST["req_oc_dat"]);
   $_REQUEST["req_oc_dat"] = (int)mktime(date('H'), date('i'), date('s'), $_REQUEST["req_oc_dat"][1], $_REQUEST["req_oc_dat"][0], $_REQUEST["req_oc_dat"][2]);



      /* Envio informacion a CRM */

      $sql       = "select * from customer where id = '{$headdata["req_cust_id"]}'";
      $idcliente = $CON->select($sql);
      $idcliente = $idcliente[0];
      $idcrm     = $idcliente['cust_id_crm'];
      $monto     = $headdata['req_total_brutto'];

      $sql        = "select nombre from comunas where id = {$idcliente['cust_comunaid']}";
      $comunas    = $CON->select($sql);
      $comuna     = $comunas[0]['nombre'];

      $sql        = "select * from regions where id = {$idcliente['cust_regionid']}";
      $regiones   = $CON->select($sql);
      $region     = $regiones[0]['name'];

      $sql        = "select * from country where id = {$idcliente['cust_countryid']}";
      $paises     = $CON->select($sql);
      $pais       = $paises[0]['country_name'];
      // echo($sql);

      $sql = "select id, cat_name, cat_crtdat from customer_cats where id = {$idcliente['cust_catid']}";
      $categorias = $CON->select($sql);
      $categoria  = $categorias[0]['cat_name'];

      $sql        = "select * from giros where id = {$idcliente['cust_giroid']}";
      $giros      = $CON->select($sql);
      $giro       = $giros[0]['giro_name'];

      $idcrm      = $idcliente['cust_id_crm'];
      $nombre     = $idcliente['cust_contacto'];
      $rut        = $idcliente['cust_rut'];
      $direccion  = $idcliente['cust_street'];
      $empresa    = $idcliente['cust_company'];
      $email      = $idcliente['cust_email'];
      $celular    = $idcliente['cust_cellphone'];

      CallApiCRM("contacto",$idcrm, $monto,$nombre,$rut,$direccion,$empresa,$email,$celular,$comuna,$region,$pais,$categoria,$giro);
      $respuesta = CallApiCRM("compra", $idcrm, $monto,$nombre,$rut,$direccion,$empresa,$email,$celular,$comuna,$region,$pais,$categoria,$giro);
      $sql = "insert into log_crm (log_crm_fecha
                                  ,log_crm_cust_id
                                  ,log_crm_cust_id_crm
                                  ,log_crm_identificador
                                  ,log_crm_accion
                                  ,log_crm_respuesta
                                  ,log_crm_idrespuesta
                                  ,log_crm_boton)                                  
              select {$currtme}
                    ,{$idcliente['id']}
                    ,'{$idcliente['cust_id_crm']}'
                    ,{$_REQUEST["id"]}
                    ,'compra'
                    ,'{$respuesta["status"]}'
                    ,'{$respuesta["id"]}'
                    ,'{$_REQUEST["subexec"]}'";

      $CON->no_result($sql);

   if($_REQUEST["req_paymentid"] != $headdata["req_paymentid"])
      $itemfullupdate = true;
   else
      $itemfullupdate = false;

   //----------------------------------------------------------------------------------
   $sql = " select *
            from orders
            where
            id = {$_REQUEST["id"]}";
   $headdata = $CON->select($sql);
   $headdata = $headdata[0];

   $revert  = false;
   $final   = false;
   if($headdata["req_status"] == 1 && $_REQUEST["req_status"] == 2)
      $final = true;
   if($headdata["req_status"] > 1 && $_REQUEST["req_status"] == 1)
      $revert = true;

   $sql = " update orders
            set
            req_status           = {$_REQUEST["req_status"]},
            req_desc             = '{$_REQUEST["req_desc"]}',
            req_desc_intern      = '{$_REQUEST["req_desc_intern"]}',
            req_number           = '{$_REQUEST["req_number"]}',
            req_paymentid        = {$_REQUEST["req_paymentid"]},
            req_userid_seller    = {$_REQUEST["req_userid_seller"]},
            req_userid_cashing   = {$_REQUEST["req_userid_cashing"]},
            req_transportid      = {$_REQUEST["req_transportid"]},
            req_cust_delivid     = {$_REQUEST["req_cust_delivid"]},
            req_oc_number        = '{$_REQUEST["req_oc_number"]}',
            req_oc_dat           = {$_REQUEST["req_oc_dat"]},
            req_discount_perc    =  {$_REQUEST["req_discount_perc"]},
            req_discount_amt     =  {$_REQUEST["req_discount_amt"]},
            req_custnameprov     = '{$_REQUEST["req_custnameprov"]}',
            req_crtdat           = {$_REQUEST["req_crtdat"]},
            req_isreserva        = {$_REQUEST["req_isreserva"]},
            req_despacho_desc    = '{$_REQUEST["req_despacho_desc"]}',
            req_embalaje_desc    = '{$_REQUEST["req_embalaje_desc"]}',
            req_pie_imprenta     = '{$_REQUEST["req_pie_imprenta"]}',
            req_cust_aviso_months = {$_REQUEST["req_cust_aviso_months"]},
            req_updusr           = {$_SESSION["user_id"]},
            req_upddat           = {$currtme}
            where
            id = {$_REQUEST["id"]}";
   $res = $CON->no_result($sql);
   $savemsg = getSaveMessage($res);

   //----------------------------------------------------------------------------------
   $poscounter = 0;
   foreach(array_keys($_REQUEST) AS $reqkey)
   {
      if(strpos($reqkey, "item_id_") !== false && strpos($reqkey, "item_id_") == 0)
      {
         $idx           = substr($reqkey, strrpos($reqkey, "_") +1);
         $existing_id   = (int)$_REQUEST["existing_id_{$idx}"];
         $existing_pos  = (int)$_REQUEST["existing_pos_{$idx}"];
         $genamount     = getPrice($_REQUEST["item_order_genamount_{$idx}"],2);
         
         $_REQUEST["item_amount_{$idx}"]  = getPrice($_REQUEST["item_amount_{$idx}"],4);

         //if($_REQUEST["item_id_{$idx}"] != "" && $_REQUEST["item_amount_{$idx}"] > 0.00 && ($_REQUEST["item_amount_{$idx}"] <= (float)$_REQUEST["stkdisponosave_{$idx}"] || $revert == true))
         if($_REQUEST["item_id_{$idx}"] != "" && $_REQUEST["item_amount_{$idx}"] > 0.00 && $revert == false)
         {
            $itemvalues    = explode("#", $_REQUEST["item_id_{$idx}"]);
            $sql_id        = (int)$itemvalues[0];
            $sql_type      = $itemvalues[1];

            if((int)$headdata["req_taxes"])
               $sql_taxesperc = getPrice($_REQUEST["item_sellprice_taxes_perc_{$idx}"], 2);
            else
               $sql_taxesperc = 0;

            //----------------------------------------------------------------------------------
            if(!(int)$headdata["req_isinvcbrutto"])
            {
               $sql_sellnetto = getPrice($_REQUEST["item_sellprice_netto_{$idx}"]);
               $sql_taxes     = (float)sprintf("%.{$_SESSION["_CONF"]["conf_number_decimal_places"]}f", $sql_sellnetto / 100 * $sql_taxesperc);
               $sql_sellprice = (float)sprintf("%.{$_SESSION["_CONF"]["conf_number_decimal_places"]}f", $sql_sellnetto + $sql_taxes);
            }
            else
            {
               $sql_sellprice = getPrice($_REQUEST["item_sellprice_brutto_{$idx}"]);
               $sql_taxes     = (float)sprintf("%.{$_SESSION["_CONF"]["conf_number_decimal_places"]}f", $sql_sellprice / (100 + $sql_taxesperc) * $sql_taxesperc);
               $sql_sellnetto = (float)sprintf("%.{$_SESSION["_CONF"]["conf_number_decimal_places"]}f", $sql_sellprice - $sql_taxes);
            }

            //----------------------------------------------------------------------------------
            //$sql_sellnetto = getPrice($_REQUEST["item_sellprice_netto_{$idx}"]);
            //$sql_taxes     = (float)sprintf("%.{$_SESSION["_CONF"]["conf_number_decimal_places"]}f", $sql_sellnetto / 100 * $sql_taxesperc);
            //$sql_sellprice = (float)sprintf("%.{$_SESSION["_CONF"]["conf_number_decimal_places"]}f", $sql_sellnetto + $sql_taxes);

            //----------------------------------------------------------------------------------
            if((int)$_REQUEST["manual_pos_{$idx}"])
               $_REQUEST["item_desc_{$idx}"] = trim(addslashes($_REQUEST["item_desc_{$idx}"]));
            else
               $_REQUEST["item_desc_{$idx}"] = "";

            //----------------------------------------------------------------------------------
            $_REQUEST["item_compdesc_{$idx}"] = str_replace("\r", "", $_REQUEST["item_compdesc_{$idx}"]);
            $_REQUEST["item_compdesc_{$idx}"] = str_replace("\n", "", $_REQUEST["item_compdesc_{$idx}"]);
            $_REQUEST["item_compdesc_{$idx}"] = str_replace("<div>", "\n", $_REQUEST["item_compdesc_{$idx}"]);
            $_REQUEST["item_compdesc_{$idx}"] = str_replace("<br>", "\n", $_REQUEST["item_compdesc_{$idx}"]);
            $_REQUEST["item_compdesc_{$idx}"] = str_replace("</div>", "", $_REQUEST["item_compdesc_{$idx}"]);
            $_REQUEST["item_compdesc_{$idx}"] = str_replace("&nbsp;", " ", $_REQUEST["item_compdesc_{$idx}"]);
            $_REQUEST["item_compdesc_{$idx}"] = strip_tags($_REQUEST["item_compdesc_{$idx}"],'<b><i></b></i>');
            $_REQUEST["item_compdesc_{$idx}"] = trim(addslashes($_REQUEST["item_compdesc_{$idx}"]));


            $_REQUEST["fab_print_colordesc_1"]  = trim(addslashes($_REQUEST["fab_print_colordesc_1"]));
            $_REQUEST["fab_print_colordesc_2"]  = trim(addslashes($_REQUEST["fab_print_colordesc_2"]));
            $_REQUEST["fab_print_colordesc_3"]  = trim(addslashes($_REQUEST["fab_print_colordesc_3"]));
            $_REQUEST["fab_print_colordesc_4"]  = trim(addslashes($_REQUEST["fab_print_colordesc_4"]));
            $_REQUEST["fab_print_colordesc_5"]  = trim(addslashes($_REQUEST["fab_print_colordesc_5"]));
            $_REQUEST["fab_design_desc"]        = trim(addslashes($_REQUEST["fab_design_desc"]));

            //----------------------------------------------------------------------------------
            $_REQUEST["fab_print_width"]        = (int)$_REQUEST["fab_print_width"];
            $_REQUEST["fab_print_height"]       = (int)$_REQUEST["fab_print_height"];
            $_REQUEST["fab_manilla_length"]     = (int)$_REQUEST["fab_manilla_length"];
            $_REQUEST["fab_mat_fabric_color"]   = (int)$_REQUEST["fab_mat_fabric_color"];
            $_REQUEST["fab_mat_manilla_color"]  = (int)$_REQUEST["fab_mat_manilla_color"];
            $_REQUEST["fab_mat_gramms"]         = (int)$_REQUEST["fab_mat_gramms"];

            //----------------------------------------------------------------------------------
            $_REQUEST["item_sellprice_trazado_{$idx}"] = getPrice($_REQUEST["item_sellprice_trazado_{$idx}"]);
            $_REQUEST["item_sellprice_barcode_{$idx}"] = getPrice($_REQUEST["item_sellprice_barcode_{$idx}"]);
            $_REQUEST["item_sellprice_barcodenumber_{$idx}"] = trim(addslashes($_REQUEST["item_sellprice_barcodenumber_{$idx}"]));

            if((int)$headdata["req_isfabricate"])
            {
               $_REQUEST["item_discount_{$idx}"]         = 0.00;
               $_REQUEST["item_discount_type_{$idx}"]    = 0;

               if($_REQUEST["item_sellprice_trazado_{$idx}"] > 0.00 || $_REQUEST["item_sellprice_barcode_{$idx}"] > 0.00)
               {
                  $_REQUEST["item_discount_{$idx}"]      = -1 * $_REQUEST["item_amount_{$idx}"] * ($_REQUEST["item_sellprice_trazado_{$idx}"] + $_REQUEST["item_sellprice_barcode_{$idx}"]);
                  $_REQUEST["item_discount_type_{$idx}"] = 1;
               }
            }

            //----------------------------------------------------------------------------------
            $newitemimg = "";
            if($_FILES["itemimage_{$idx}"]["name"] != "" &&
               $_FILES["itemimage_{$idx}"]["tmp_name"] != "" &&
               $_FILES["itemimage_{$idx}"]["error"] == 0 &&
               $_FILES["itemimage_{$idx}"]["size"] > 0)
            {
               $doc_type = substr($_FILES["itemimage_{$idx}"]["name"], strrpos($_FILES["itemimage_{$idx}"]["name"], ".") +1);
               if(strtoupper($doc_type) == "JPG" || strtoupper($doc_type) == "JPEG")
               {
                  $doc_hash = md5(microtime());
                  $doc_name = "{$_REQUEST["id"]}_{$doc_hash}.{$doc_type}";
                  $doc_dir  = "{$_SESSION["_CONF"]["conf_shopadmin_path"]}docs.offer/";
                  $ftres    = move_uploaded_file($_FILES["itemimage_{$idx}"]["tmp_name"], "{$doc_dir}{$doc_name}");
                  if($ftres)
                  {
                     resizeImage("{$doc_dir}{$doc_name}", 300, "", "{$doc_dir}{$doc_name}");
                     $newitemimg = $doc_name;
                  }
               }
            }

            //----------------------------------------------------------------------------------
            $newitemimgdesign = "";
            if($_FILES["fab_design_imagehash"]["name"] != "" &&
               $_FILES["fab_design_imagehash"]["tmp_name"] != "" &&
               $_FILES["fab_design_imagehash"]["error"] == 0 &&
               $_FILES["fab_design_imagehash"]["size"] > 0)
            {
               $doc_type = substr($_FILES["fab_design_imagehash"]["name"], strrpos($_FILES["fab_design_imagehash"]["name"], ".") +1);
               if(strtoupper($doc_type) == "JPG" || strtoupper($doc_type) == "JPEG")
               {
                  $doc_hash = md5(microtime());
                  $doc_name = "{$_REQUEST["id"]}_{$doc_hash}.{$doc_type}";
                  $doc_dir  = "{$_SESSION["_CONF"]["conf_shopadmin_path"]}docs.order/";
                  $ftres    = move_uploaded_file($_FILES["fab_design_imagehash"]["tmp_name"], "{$doc_dir}{$doc_name}");
                  if($ftres)
                  {
                     resizeImage("{$doc_dir}{$doc_name}", 2048, "", "{$doc_dir}{$doc_name}");
                     $newitemimgdesign = $doc_name;
                  }
               }
            }

            //----------------------------------------------------------------------------------
            if($existing_id)
            {
               $sql = " update orders_items
                        set
                        item_amount                = {$_REQUEST["item_amount_{$idx}"]},
                        item_sellprice_brutto      = {$sql_sellprice},
                        item_sellprice_taxes_perc  = {$sql_taxesperc},
                        item_sellprice_netto       = {$sql_sellnetto},
                        item_sellprice_taxes       = {$sql_taxes},
                        item_order_genamount       = {$genamount},
                        item_pos                   = {$poscounter},
                        item_desc                  = '{$_REQUEST["item_desc_{$idx}"]}',
                        item_compdesc              = '{$_REQUEST["item_compdesc_{$idx}"]}',
                        fab_print_colordesc_1      = '{$_REQUEST["fab_print_colordesc_1"]}',
                        fab_print_colordesc_2      = '{$_REQUEST["fab_print_colordesc_2"]}',
                        fab_print_colordesc_3      = '{$_REQUEST["fab_print_colordesc_3"]}',
                        fab_print_colordesc_4      = '{$_REQUEST["fab_print_colordesc_4"]}',
                        fab_print_colordesc_5      = '{$_REQUEST["fab_print_colordesc_5"]}',
                        fab_design_desc            = '{$_REQUEST["fab_design_desc"]}',
                        item_sellprice_trazado     = {$_REQUEST["item_sellprice_trazado_{$idx}"]},
                        item_sellprice_barcode     = {$_REQUEST["item_sellprice_barcode_{$idx}"]},
                        item_sellprice_barcodenumber = '{$_REQUEST["item_sellprice_barcodenumber_{$idx}"]}',
                        fab_print_width            = {$_REQUEST["fab_print_width"]},
                        fab_print_height           = {$_REQUEST["fab_print_height"]},
                        fab_manilla_length         = {$_REQUEST["fab_manilla_length"]},
                        fab_mat_fabric_color       = {$_REQUEST["fab_mat_fabric_color"]},
                        fab_mat_manilla_color      = {$_REQUEST["fab_mat_manilla_color"]},
                        fab_mat_gramms             = {$_REQUEST["fab_mat_gramms"]}
                        where
                        req_id   = {$_REQUEST["id"]} and
                        item_id  = {$existing_id} and
                        item_pos = {$existing_pos}";
               $CON->no_result($sql);

               if($newitemimg != "")
               {
                  $sql = " update orders_items
                           set
                           item_img_hash = '{$newitemimg}'
                           where
                           req_id   = {$_REQUEST["id"]} and
                           item_id  = {$existing_id} and
                           item_pos = {$existing_pos}";
                  $CON->no_result($sql);      
               }

               if($newitemimgdesign != "")
               {
                  $sql = " update orders_items
                           set
                           fab_design_imagehash = '{$newitemimgdesign}'
                           where
                           req_id   = {$_REQUEST["id"]} and
                           item_id  = {$existing_id} and
                           item_pos = {$existing_pos}";
                  $CON->no_result($sql);      
               }

               recalcOrderItem($CON, $_REQUEST["id"], $existing_id, $poscounter, $itemfullupdate, "");

               //----------------------------------------------------------------------------------
               $_TABLENAME    = "orders_items";
               $_TABLENAMEHD  = "orders";
               $_COLPREFIX    = "req";
               $_AMOUNTFIELD  = "item_amount";

               //----------------------------------------------------------------------------------
               if(!$itemfullupdate)
               {
                  $_REQUEST["item_pcat_dsc_act_{$idx}"]     = (int)$_REQUEST["item_pcat_dsc_act_{$idx}"];
                  $_REQUEST["item_vol_act_{$idx}"]          = (int)$_REQUEST["item_vol_act_{$idx}"];
                  $_REQUEST["item_value_act_{$idx}"]        = (int)$_REQUEST["item_value_act_{$idx}"];

                  $_REQUEST["item_discount_{$idx}"]         = getPrice($_REQUEST["item_discount_{$idx}"],2);
                  $_REQUEST["item_discount_type_{$idx}"]    = (int)$_REQUEST["item_discount_type_{$idx}"];

                  for($y = 1; $y <= 4; $y++)
                     $_REQUEST["item_pcat_dsc_{$idx}_{$y}"] = getPrice($_REQUEST["item_pcat_dsc_{$idx}_{$y}"],2);

                  $sql = " update {$_TABLENAME}
                           set
                           item_discount        = {$_REQUEST["item_discount_{$idx}"]},
                           item_discount_type   = {$_REQUEST["item_discount_type_{$idx}"]},
                           item_pcat_dsc_act    = {$_REQUEST["item_pcat_dsc_act_{$idx}"]},
                           item_pcat_dsc1       = {$_REQUEST["item_pcat_dsc_{$idx}_1"]},
                           item_pcat_dsc2       = {$_REQUEST["item_pcat_dsc_{$idx}_2"]},
                           item_pcat_dsc3       = {$_REQUEST["item_pcat_dsc_{$idx}_3"]},
                           item_pcat_dsc4       = {$_REQUEST["item_pcat_dsc_{$idx}_4"]},
                           item_vol_act         = {$_REQUEST["item_vol_act_{$idx}"]},
                           item_value_act       = {$_REQUEST["item_value_act_{$idx}"]}
                           where
                           {$_COLPREFIX}_id     = {$_REQUEST["id"]} and
                           item_pos             = {$poscounter}";
                  $CON->no_result($sql);
               }
            }
            else
            {
               $sql = " insert into orders_items
                        (req_id, item_id, item_pos, item_amount, item_type, item_sellprice_brutto,
                         item_sellprice_taxes_perc, item_sellprice_netto, item_sellprice_taxes, item_desc,
                         item_order_genamount, item_compdesc)
                        VALUES
                        ({$_REQUEST["id"]}, {$sql_id}, {$poscounter}, {$_REQUEST["item_amount_{$idx}"]}, '{$sql_type}',
                         {$sql_sellprice}, {$sql_taxesperc}, {$sql_sellnetto}, {$sql_taxes}, '{$_REQUEST["item_desc_{$idx}"]}',
                         {$genamount}, '{$_REQUEST["item_compdesc_{$idx}"]}')";
               $CON->no_result($sql);

               recalcOrderItem($CON, $_REQUEST["id"], $sql_id, $poscounter, true, "");
            }

            $poscounter++;
         }
         else
         {
            if($existing_id)
            {
               $sql = " delete from orders_items
                        where
                        req_id   = {$_REQUEST["id"]} and
                        item_id  = {$existing_id} and
                        item_pos = {$existing_pos}";
               $CON->no_result($sql);
            }

            if($_REQUEST["item_id_{$idx}"] != "" && $_REQUEST["item_amount_{$idx}"] > 0.00 && $_REQUEST["item_amount_{$idx}"] > (float)$_REQUEST["stkdisponosave_{$idx}"])
            {
               $sql = " select *
                        from item
                        where
                        id = {$_REQUEST["item_id_{$idx}"]}";
               $titem = $CON->select($sql);
               $titem = $titem[0];

               $titem["item_title"] = str_replace("'", "", $titem["item_title"]);

               $alertdesc = "EL PRODUCTO \'{$titem["item_number_prod"]} - {$titem["item_title"]}\' NO TIENE SUFICIENTE STOCK. ";
               ?>
               <script language="JavaScript">
                  alert('<?=$alertdesc?>');
               </script>
               <?
            }
         }
      }
   }

   //----------------------------------------------------------------------------------
   if($_REQUEST["delposimg"] != "")
   {
      $delposimgarr = explode("-", $_REQUEST["delposimg"]);

      $sql = " update orders_items
               set
               item_img_hash = ''
               where
               req_id   = {$_REQUEST["id"]} and
               item_id  = {$delposimgarr[0]} and
               item_pos = {$delposimgarr[1]}";
      $CON->no_result($sql);
   }

   //----------------------------------------------------------------------------------
   if($_REQUEST["deldesignimg"] != "")
   {
      $delposimgarr = explode("-", $_REQUEST["deldesignimg"]);

      $sql = " update orders_items
               set
               fab_design_imagehash = ''
               where
               req_id   = {$_REQUEST["id"]} and
               item_id  = {$delposimgarr[0]} and
               item_pos = {$delposimgarr[1]}";
      $CON->no_result($sql);
   }

   //----------------------------------------------------------------------------------
   $_REQUEST["dlv_weightprice_netto"]     = getPrice($_REQUEST["dlv_weightprice_netto"]);
   $_REQUEST["req_trazlogoprice_netto"]   = getPrice($_REQUEST["req_trazlogoprice_netto"]);
   
   $sql = " update orders
            set
            req_weightprice_netto   = {$_REQUEST["dlv_weightprice_netto"]},
            req_trazlogoprice_netto = {$_REQUEST["req_trazlogoprice_netto"]}
            where
            id = {$_REQUEST["id"]}";
   $CON->no_result($sql);

   //----------------------------------------------------------------------------------
   $sql = " select count(*) 'cc'
            from orders t1
            INNER JOIN orders t2 ON (t1.req_status > 0 and t2.req_status > 0 and t1.req_number = t2.req_number)
            where
            t1.id = {$_REQUEST["id"]}";
   $shpdoccheck = $CON->select($sql);
   if((int)$shpdoccheck[0]["cc"] > 1)
      $_SESSION["JSEXEC"] .= ";alert('EL NUMERO DE YA EXISTE');";

   recalcOrder($CON, $_REQUEST["id"]);

   //----------------------------------------------------------------------------------
   if($final)
   {
      //

      if((int)$headdata["req_isfabricate"])
      {
         $pdflink = "{$_SESSION["_CONF"]["conf_shopadmin_url"]}libs/modules/orders/data.pdf.php?id={$_REQUEST["id"]}";
         $pdfdata = file_get_contents($pdflink);

         $hash       = md5(microtime());
         $filedir    = "{$_SESSION["_CONF"]["conf_shopadmin_path"]}docs.order/";
         $doctype    = "ncorder";
         $filename   = "{$filedir}{$_REQUEST["id"]}-{$doctype}-{$hash}.pdf";
         file_put_contents($filename, $pdfdata);

          //----------------------------------------------------------------------------------
         $sql = " update orders
                  set
                  req_hash   = '{$_REQUEST["id"]}-{$doctype}-{$hash}.pdf'
                  where
                  id          = {$_REQUEST["id"]}";
         $CON->no_result($sql);
      }
      else
      {
         doc_createOrder($CON, $_REQUEST["id"]);
      }
   }

}

//----------------------------------------------------------------------------------
if($_REQUEST["subexec"] == "send")
{
   foreach($_REQUEST["xcco"] AS $xccouid)
   {
      $sql = " select *
               from user
               where
               id = {$xccouid}";
      $ccouser = $CON->select($sql);
      $ccouser = $ccouser[0];

      $temp["NAME"] = $ccouser["user_firstname"]." ".$ccouser["user_lastname"];
      $temp["ADDR"] = $ccouser["user_mail"];
      $_CCOADDR[]   = $temp;
   }

   $currtme = time();

   $pdflink = "{$_SESSION["_CONF"]["conf_shopadmin_url"]}libs/modules/orders/data.pdf.php?id={$_REQUEST["id"]}";
   $pdfdata = file_get_contents($pdflink);

   $hash       = md5(microtime());
   $filedir    = "{$_SESSION["_CONF"]["conf_shopadmin_path"]}docs.print/";
   $doctype    = "ncorder";
   $filename   = "{$filedir}{$_REQUEST["id"]}-{$doctype}-{$hash}.pdf";

   //----------------------------------------------------------------------------------
   if($handle = opendir($filedir))
   {
      while (false !== ($file = readdir($handle)))
         if ($file != "." && $file != ".." && strpos($file,"{$_REQUEST["id"]}-{$doctype}-") !== false)
            unlink("{$filedir}{$file}");
      closedir($handle);
   }

   file_put_contents($filename, $pdfdata);

   //----------------------------------------------------------------------------------
   $sql = " select *
            from orders
            where
            id = {$_REQUEST["id"]}";
   $headdata = $CON->select($sql);
   $headdata = $headdata[0];
   
   $temp["NAME"]     = "{$headdata["req_number"]}.pdf";
   $temp["FILE"]     = $filename;
   $attachfiles[0]   = $temp;

   $text    = '<html>
               <head><style type="text/css">body{font-family:Arial;font-size:12px;}</style></head>
               <body style="margin:10px" class="page">'.$_REQUEST["msg_body"].'</body></html>';

   $sentmails = sendExternalMail($_REQUEST["msg_header"],
                                 $text,
                                 $_REQUEST["msg_toaddr"],
                                 $_REQUEST["msg_toname"],
                                 "",
                                 "",
                                 $attachfiles);
   if($sentmails <= 0)
      $savemsg = getSaveMessage(false);
   else
      $savemsg = getSaveMessage(true);
}

//----------------------------------------------------------------------------------
$sql = " select t1.*, t2.cust_name, t2.cust_email, t3.company_short, t4.shop_name, t1.req_cust_id, t2.cust_notes, t7.pay_title,
                t5.user_firstname 'upd_firstname', t5.user_lastname 'upd_lastname',
                t6.user_firstname 'crt_firstname', t6.user_lastname 'crt_lastname',
                t8.user_firstname 'seller_firstname', t8.user_lastname 'seller_lastname',
                t9.user_firstname 'cashing_firstname', t9.user_lastname 'cashing_lastname',
                t10.trans_name
         from orders t1
         LEFT OUTER JOIN customer t2         ON t1.req_cust_id          = t2.id
         LEFT OUTER JOIN company_data t3     ON t1.req_company_id       = t3.id
         LEFT OUTER JOIN company_shops t4    ON t1.req_shop_id          = t4.id
         LEFT OUTER JOIN user t5             ON t1.req_updusr           = t5.id
         LEFT OUTER JOIN user t6             ON t1.req_crtusr           = t6.id
         LEFT OUTER JOIN payments t7         ON t1.req_paymentid        = t7.id
         LEFT OUTER JOIN user t8             ON t1.req_userid_seller    = t8.id
         LEFT OUTER JOIN user t9             ON t1.req_userid_cashing   = t9.id
         LEFT OUTER JOIN transports t10      ON t1.req_transportid      = t10.id
         where
         t1.id = {$_REQUEST["id"]}";
$headdata = $CON->select($sql);
$headdata = $headdata[0];

//----------------------------------------------------------------------------------
$sql = " select *
         from user
         where
         id = {$_SESSION["user_id"]}";
