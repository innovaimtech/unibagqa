if((int)$_SESSION["user_pricesell_perm"] || (int)$_REQUEST["user_pricesell_perm"])
   $hasprcsellperm = true;
else
   $hasprcsellperm = false;


//----------------------------------------------------------------------------------
$custselarr = Array();
   
$custname = str_replace(",","", str_replace("'","", str_replace('"',"", trim($headdata["cust_name"]))));
$custmail = str_replace(",","", str_replace("'","", str_replace('"',"", trim($headdata["cust_email"]))));
if($custmail != "")
{
   $temp["NAME"] = $custname;
   $temp["MAIL"] = $custmail;

   array_push($custselarr, $temp);
}
//----------------------------------------------------------------------------------
$sql = " select add_email, add_firstname, add_lastname
         from customer_contacts
         where
         add_cust_id = {$headdata["req_cust_id"]}
         order by add_pos asc";
$suppcontacts = $CON->select($sql);

//----------------------------------------------------------------------------------
for($x = 0; $x < count($suppcontacts) && $suppcontacts != false; $x++)
{
   $custname = str_replace(",","", str_replace("'","", str_replace('"',"", trim($suppcontacts[$x]["add_firstname"]." ".$suppcontacts[$x]["add_lastname"]))));
   $custmail = str_replace(",","", str_replace("'","", str_replace('"',"", trim($suppcontacts[$x]["add_email"]))));

   if($custmail != "")
   {
      $temp["NAME"] = $custname;
      $temp["MAIL"] = $custmail;

      array_push($custselarr, $temp);
   }
}

//----------------------------------------------------------------------------------
if($_SESSION["xorders"]["fullcust"] == "1")
   $cdatastyle = 'style="border-top-width:3px;border-top-style:solid"';

$proms = getActivePromotions($CON, $headdata["req_shop_id"]);

//----------------------------------------------------------------------------------
if((int)$_REQUEST["senddesignmail"])
{
   $currtme = time() + 86400;
   $sql = " update orders
            set
            req_design_blocked_uid = 0,
            req_designupload_act   = 1,
            req_designupload_alertdate = {$currtme}
            where
            id = {$_REQUEST["id"]}";
   $CON->no_result($sql);
   
   generateDesignMail($CON, $headdata, $posdata);
}

if((int)$_REQUEST["sendprodmail"])
   generateDesignFabricationMail($CON, $headdata, $posdata);

$sql = " select id, user_firstname, user_lastname, user_mail
         from user
         where
         user_status > 0 and
         user_mail like '%@%'
         order by user_firstname, user_lastname";
$ccousers = $CON->select($sql);
