                     <option value="<?=$planta["id"]?>" <?if($planta["id"] == $proddata["prd_plantaid"]) echo "selected"?>><?=$planta["planta_name"]?></option>
                     <?
                  }
                  ?>
               </select>
               <div style="height:3px"></div>
               <textarea name="prd_desc" class="text" style="width:100%;height:<?=((5 * 28)-28)?>px;min-height:60px"></textarea>
            </td>
            <?
         }  
         ?>
      </tr>
      <?
   }
   ?>
   </table>
   <?=Nifty_printF(false)?>
   <br>
   <?=Nifty_printH("boxopt_b", "1020")?>
   <table border="0" cellspacing="0" cellpadding="0" width="100%">
   <tr>
      <td width="130" style="padding-right:5px" align="right">
         <?
         printButton("Iniciar Fabricación", "postnav_save", "javascript: deactivateFormChange()", "if(askDel('')) { submitForm(document.form_prodinit); }", "tick-circle-frame", 140);
         ?>
      </td>
   </tr>
   </table>
   <?=Nifty_printF(false)?>
   <?
}
