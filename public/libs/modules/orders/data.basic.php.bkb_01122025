               $trancomid1 = $items[$i];
               echo "<td class='content_rowl'>{$_TRANSCOM[$trancomid1]['NAME']}</td>";
               echo "<td class='content_row'>";
               echo "<select class='text' style='width:350px' name='comvals_{$trancomid1}' id='comvals_{$trancomid1}'>";
               echo "<option value=''>< {$_LANG['FORM']['OPTION'][0]} ></option>";
               foreach (array_keys($_TRANSCOM[$trancomid1]["OPTS"]) as $trancomvalid1) {
                  $selected = ((int)$_COMVALS[$trancomid1] == $trancomvalid1) ? "selected" : "";
                  echo "<option value='{$trancomvalid1}' {$selected}>{$_TRANSCOM[$trancomid1]['OPTS'][$trancomvalid1]}</option>";
               }
               echo "</select></td>";

               // Segunda columna (si existe)
               if (($i + 1) < $total) {
                  $trancomid2 = $items[$i + 1];
                  echo "<td class='content_rowl'>{$_TRANSCOM[$trancomid2]['NAME']}</td>";
                  echo "<td class='content_row'>";
                  echo "<select class='text' style='width:350px;' name='comvals_{$trancomid2}' id='comvals_{$trancomid2}'>";
                  echo "<option value=''>< {$_LANG['FORM']['OPTION'][0]} ></option>";
