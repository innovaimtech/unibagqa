                           item_vol_act         = {$_REQUEST["item_vol_act_{$idx}"]},
                           item_value_act       = {$_REQUEST["item_value_act_{$idx}"]}
                           where
                           {$_COLPREFIX}_id     = {$_REQUEST["id"]} and
                           item_pos             = {$poscounter}";
                  $CON->no_result($sql);
               }
            }
            else
            {
               $sql = " insert into orders_items
                        (req_id, item_id, item_pos, item_amount, item_type, item_sellprice_brutto,
                         item_sellprice_taxes_perc, item_sellprice_netto, item_sellprice_taxes, item_desc,
                         item_order_genamount, item_compdesc)
                        VALUES
                        ({$_REQUEST["id"]}, {$sql_id}, {$poscounter}, {$_REQUEST["item_amount_{$idx}"]}, '{$sql_type}',
                         {$sql_sellprice}, {$sql_taxesperc}, {$sql_sellnetto}, {$sql_taxes}, '{$_REQUEST["item_desc_{$idx}"]}',
                         {$genamount}, '{$_REQUEST["item_compdesc_{$idx}"]}')";
               $CON->no_result($sql);

               recalcOrderItem($CON, $_REQUEST["id"], $sql_id, $poscounter, true, "");
            }

            $poscounter++;
         }
         else
         {
            if($existing_id)
            {
               $sql = " delete from orders_items
                        where
                        req_id   = {$_REQUEST["id"]} and
                        item_id  = {$existing_id} and
                        item_pos = {$existing_pos}";
               $CON->no_result($sql);
            }

            if($_REQUEST["item_id_{$idx}"] != "" && $_REQUEST["item_amount_{$idx}"] > 0.00 && $_REQUEST["item_amount_{$idx}"] > (float)$_REQUEST["stkdisponosave_{$idx}"])
            {
               $sql = " select *
                        from item
                        where
                        id = {$_REQUEST["item_id_{$idx}"]}";
               $titem = $CON->select($sql);
