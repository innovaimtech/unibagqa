//----------------------------------------------------------------------------------
if((int)$_REQUEST["generateInvoices"])
{
   $itemsperinvoice     = 999999;
   $invc_date           = mktime(15, 0, 0, date('m'), date('d'), date('Y'));
   $invc_delivery_date  = $invc_date;
   $invc_stockchange    = 0;
   $rowcount            = count($posdata);
   $geninvoices         = ceil($rowcount / $itemsperinvoice);
   $deleteafterpos      = 0;
   $orderdiscountamt    = $headdata["req_discount_amt"];
   $ordertotalnetto     = $headdata["req_total_netto"];
   $invc_isinvcbrutto   = (int)$headdata["req_isinvcbrutto"];

   //----------------------------------------------------------------------------------
   for($x = 0; $x < $geninvoices; $x++)
   {
      $invc_number      = createTransactionNumber($CON, $headdata["req_company_id"], "invoicesell");
      $invc_dlv_docnum  = $invc_number;
      $deleteafterpos   += $itemsperinvoice;

      $deleteposidx_before = $deleteafterpos - $itemsperinvoice;
      $deleteposidx_after  = $deleteafterpos -1;

      //----------------------------------------------------------------------------------
      $sql = " select t1.cust_paymentid, t1.cust_sellerid, t1.cust_transportid, t2.pay_days
               from customer t1
               LEFT OUTER JOIN payments t2 ON t1.cust_paymentid = t2.id
               where
               t1.id = {$headdata["req_cust_id"]}";
      $xcustdata = $CON->select($sql);
      $xcustdata = $xcustdata[0];

      $currtme          = time();
      $invc_paymentdays = (int)$xcustdata["pay_days"];
      $tmp_estpay       = time() + ($invc_paymentdays * 86400);
      $invc_estpay_date = mktime(15, 0, 0, date('m', $tmp_estpay), date('d', $tmp_estpay), date('Y', $tmp_estpay));

      //----------------------------------------------------------------------------------
      $sql = " insert into invoices_sell
               (invc_number, invc_cust_id, invc_company_id, invc_shop_id, invc_date, invc_receipt_date,
                invc_taxes, invc_type, invc_stockchange, invc_userid_seller, invc_userid_cashing,
                invc_paymentid, invc_transportid, invc_delivery_date, invc_dlv_docnum, invc_estpay_date,
                invc_docnumber, invc_crtdat, invc_crtusr, invc_cust_delivid, invc_isinvcbrutto)
               VALUES
               ('{$invc_number}', {$headdata["req_cust_id"]}, {$headdata["req_company_id"]},
                 {$headdata["req_shop_id"]}, {$invc_date}, {$invc_date}, {$headdata["req_taxes"]}, 2,
                 {$invc_stockchange}, {$headdata["req_userid_seller"]}, {$headdata["req_userid_cashing"]}, {$headdata["req_paymentid"]},
                 {$headdata["req_transportid"]}, {$invc_date}, '{$invc_number}', {$invc_estpay_date},
                 '{$invc_number}', {$currtme}, {$_SESSION["user_id"]}, {$headdata["req_cust_delivid"]},
                 {$invc_isinvcbrutto})";
      $res = $CON->no_result($sql);
      if($res)
      {
         $sql = " select MAX(id) 'thisid'
                  from invoices_sell
                  where
                  invc_crtusr = {$_SESSION["user_id"]}";
         $invoiceid = $CON->select($sql);
         $invoiceid = $invoiceid[0]["thisid"];

         invoiceSellAddOrder($CON, $invoiceid, $_REQUEST["id"]);

         $sql = " delete from invoices_sell_parts_items
                  where
                  invc_id  = {$invoiceid} and
                  (
                     item_pos < {$deleteposidx_before} or
                     item_pos > {$deleteposidx_after}
                  )";
         $CON->no_result($sql);

         $sql = " update invoices_sell
                  set
                  invc_discount_amt = 0.00
                  where
                  id = {$invoiceid}";
         $CON->no_result($sql);

         recalcOrder($CON, $invoiceid, "INVOICE");

         $sql = " select invc_total_netto
                  from invoices_sell
                  where
                  id = {$invoiceid}";
         $tempnetto = $CON->select($sql);
         $tempnetto = $tempnetto[0]["invc_total_netto"];

         $_INVCNETTOS[$invoiceid]["NETTO"] = $tempnetto;
         $_TOTALNETTO += $tempnetto;
      }
   }
   foreach(array_keys($_INVCNETTOS) AS $invcid)
   {
      $nettoamt   = $_INVCNETTOS[$invcid]["NETTO"];
      $nettoprc   = $nettoamt / $_TOTALNETTO * 100;
      $dscamt     = round($orderdiscountamt / 100 * $nettoprc,0);
      $_INVCNETTOS[$invcid]["DISCOUNT"] = $dscamt;
   }
   $_INVCNETTOS = calcNormalizeDiscountArray($_INVCNETTOS, $orderdiscountamt);
   foreach(array_keys($_INVCNETTOS) AS $invcid)
   {
      $invc_discount_amt = (float)$_INVCNETTOS[$invcid]["DISCOUNT"];

      $sql = " update invoices_sell
               set
               invc_discount_amt = {$invc_discount_amt}
               where
               id = {$invcid}";
      $CON->no_result($sql);
      recalcOrder($CON, $invcid, "INVOICE");

      $sql = " select invc_number
               from invoices_sell
               where
               id = {$invcid}";
      $invc_number = $CON->select($sql);
      $invc_number = $invc_number[0]["invc_number"];
      $invc_number_str .= $invc_number.", ";


      
   }
   $invc_number_str = substr($invc_number_str, 0, -2);

   if(count($_INVCNETTOS) > 1)
   {  ?>
      <script language="JavaScript">
         alert('FACTURAS GENERADAS: <?=$invc_number_str?>\nFAVOR INGRESA A LOS DOCUMENTOS VIA EL MENU.');
      </script>
      <?
   }
   else
   {  ?>
      <script language="JavaScript">
         //alert('FACTURA GENERADA: <?=$invc_number_str?>');
         location.href='/index.php?mid=751&exec=edit&subexec=edit&id=<?=$invcid?>';
      </script>
      <?
   }
}
