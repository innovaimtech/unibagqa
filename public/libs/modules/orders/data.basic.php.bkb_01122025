//----------------------------------------------------------------------------------
if($_REQUEST["subexec"] == "prodinitsave" && (int)$_REQUEST["prodact"])
{
   $currtme = time();

   $_REQUEST["prd_plantaid"]  = (int)$_REQUEST["prd_plantaid"];
   $_REQUEST["prd_desc"]      = trim(addslashes($_REQUEST["prd_desc"]));

   $sql = " insert into prod_header
            (prd_crtdat, prd_crtusr, prd_status, prd_desc, prd_plantaid, prd_reqid)
            VALUES
            ({$currtme}, {$_SESSION["user_id"]}, 1, '{$_REQUEST["prd_desc"]}', {$_REQUEST["prd_plantaid"]},
             {$_REQUEST["id"]})";
   $res = $CON->no_result($sql);
   if($res)
   {
      $prodid = mysql_insert_id();
   
      foreach(array_keys($_REQUEST) AS $reqkey)
      {
         if(strpos($reqkey, "prodplan_amt_") !== false && strpos($reqkey, "prodplan_amt_") == 0)
         {
            $idx = substr($reqkey, strrpos($reqkey, "_") +1);

            $prodplan_amt  = getPrice($_REQUEST["prodplan_amt_{$idx}"]);
            $prodplan_date = trim($_REQUEST["prodplan_date_{$idx}"]);

            if($prodplan_amt > 0 && $prodplan_date != "")
            {
               $prodplan_date = explode(".", $prodplan_date);
               $prodplan_date = mktime(15, 0, 0, $prodplan_date[1], $prodplan_date[0], $prodplan_date[2]);
               $sql = " insert into prod_amtplan
                        (prodplan_amt, prodplan_date, prodplan_prdid)
                        VALUES
                        ({$prodplan_amt}, {$prodplan_date}, {$prodid})";
               $CON->no_result($sql);
            }
         }
      }

      $sql = " update orders
               set
               req_production_act = 1,
               req_production_initdate = {$currtme}
               where
               id = {$_REQUEST["id"]}";
      $res = $CON->no_result($sql);

      $_REQUEST['sendprodmail'] = 1;
   }

   $savemsg = getSaveMessage($res);
}
//----------------------------------------------------------------------------------------------------------------------------------------
if($_REQUEST["subexec"] == "create")
{
   $currtme = time();

   $_REQUEST["cust_id_0"]     = (int)$_REQUEST["cust_id_0"];
   $_REQUEST["company_id"]    = (int)$_REQUEST["company_id"];
   $_REQUEST["shop_id"]       = (int)$_REQUEST["shop_id"];
   $_REQUEST["req_taxes"]     = (int)$_REQUEST["req_taxes"];
   $_REQUEST["req_isinvcbrutto"] = (int)$_REQUEST["req_isinvcbrutto"];
   $_REQUEST["req_isreserva"] = (int)$_REQUEST["req_isreserva"];
   $_REQUEST["order_id"]      = (int)$_REQUEST["order_id"];

   //----------------------------------------------------------------------------------
   $sql = " select t1.cust_paymentid, t1.cust_sellerid, t1.cust_transportid, t2.pay_days
            from customer t1
            LEFT OUTER JOIN payments t2 ON t1.cust_paymentid = t2.id
            where
            t1.id = {$_REQUEST["cust_id_0"]}";
   $custdata = $CON->select($sql);
   $custdata = $custdata[0];

   $req_userid_seller   = (int)$custdata["cust_sellerid"];
   $req_userid_cashing  = (int)$custdata["cust_sellerid"];
   $req_paymentid       = (int)$custdata["cust_paymentid"];
   $req_paymentdays     = (int)$custdata["pay_days"];
   $req_transportid     = (int)$custdata["cust_transportid"];

   //----------------------------------------------------------------------------------
   $_SELLRET = sellerHasReplacement($CON, $req_userid_seller, time());
   $seller_repluserid   = $_SELLRET["SELLER"];
   $cashing_repluserid  = $_SELLRET["CASHER"];

   //----------------------------------------------------------------------------------
   if((int)$seller_repluserid)
      $req_userid_seller = $seller_repluserid;
   if((int)$cashing_repluserid)
      $req_userid_cashing = $cashing_repluserid;

   //----------------------------------------------------------------------------------
   $req_num = createTransactionNumber($CON, $_REQUEST["company_id"], "invoice");

   //----------------------------------------------------------------------------------
   $sql = " insert into orders
            (req_number, req_company_id, req_shop_id, req_cust_id, req_paymentid, 
             req_userid_seller, req_userid_cashing, req_taxes, req_transportid,
             req_crtdat, req_crtusr, req_isinvcbrutto, req_isreserva, req_crtdat_first)
            VALUES
            ('{$req_num}', {$_REQUEST["company_id"]}, {$_REQUEST["shop_id"]}, {$_REQUEST["cust_id_0"]},
              {$req_paymentid}, {$req_userid_seller}, {$req_userid_cashing}, {$_REQUEST["req_taxes"]},
              {$req_transportid}, {$currtme}, {$_SESSION["user_id"]}, {$_REQUEST["req_isinvcbrutto"]},
              {$_REQUEST["req_isreserva"]}, {$currtme})";
   $res = $CON->no_result($sql);

   if($res)
   {
      $sql = " select MAX(id) 'thisid'
               from orders
               where
               req_crtusr = {$_SESSION["user_id"]}";
      $sorder = $CON->select($sql);
      $_REQUEST["id"]   = $sorder[0]["thisid"];

      if((int)$_REQUEST["order_id"])
      {
         $sql = " insert into orders_rels
                  (req_id_1, req_id_2)
                  VALUES
                  ({$_REQUEST["id"]}, {$_REQUEST["order_id"]})";
         $CON->no_result($sql);
      }

      ?>
      <script language="JavaScript">
         location.href = 'index.php?mid=689&exec=edit&id=<?=$_REQUEST["id"]?>'
      </script>
      <?
   }

   $savemsg = getSaveMessage($res);
}

//----------------------------------------------------------------------------------
if($_REQUEST["subexec"] == "save")
{
   $currtme = time();
   //----------------------------------------------------------------------------------
   $sql = " select *
            from orders
            where
            id = {$_REQUEST["id"]}";
   $headdata = $CON->select($sql);
   $headdata = $headdata[0];

   $_REQUEST["order_id"] = (int)$_REQUEST["order_id"];
   if((int)$_REQUEST["order_id"] && $_REQUEST["order_id"] != $_REQUEST["id"])
   {
      $sql = " insert into orders_rels
               (req_id_1, req_id_2)
               VALUES
               ({$_REQUEST["id"]}, {$_REQUEST["order_id"]})";
      $CON->no_result($sql);
   }
  
   //----------------------------------------------------------------------------------
   $_REQUEST["req_desc"]            = trim(addslashes($_REQUEST["req_desc"]));
   $_REQUEST["req_desc_intern"]     = trim(addslashes($_REQUEST["req_desc_intern"]));
   $_REQUEST["req_number"]          = trim(addslashes($_REQUEST["req_number"]));
   $_REQUEST["req_crtdat"]          = trim(addslashes($_REQUEST["req_crtdat"]));
   $_REQUEST["req_custnameprov"]    = trim(addslashes($_REQUEST["req_custnameprov"]));
   $_REQUEST["req_paymentid"]       = (int)$_REQUEST["req_paymentid"];
   $_REQUEST["req_userid_seller"]   = (int)$_REQUEST["req_userid_seller"];
   $_REQUEST["req_userid_cashing"]  = (int)$_REQUEST["req_userid_cashing"];
   $_REQUEST["req_transportid"]     = (int)$_REQUEST["req_transportid"];
   $_REQUEST["req_cust_delivid"]    = (int)$_REQUEST["req_cust_delivid"];
   $_REQUEST["req_isreserva"]       = (int)$_REQUEST["req_isreserva"];
   $_REQUEST["req_cust_aviso_months"] = (int)$_REQUEST["req_cust_aviso_months"];
   $_REQUEST["req_despacho_desc"]   = trim(addslashes($_REQUEST["req_despacho_desc"]));
   $_REQUEST["req_oc_dat"]          = trim(addslashes($_REQUEST["req_oc_dat"]));
   $_REQUEST["req_oc_number"]       = trim(addslashes($_REQUEST["req_oc_number"]));
   $_REQUEST["req_embalaje_desc"]   = trim(addslashes($_REQUEST["req_embalaje_desc"]));
   $_REQUEST["req_pie_imprenta"]    = trim(addslashes($_REQUEST["req_pie_imprenta"]));
   $_REQUEST["req_discount_perc"]   = getPrice($_REQUEST["req_discount_perc"],2);
   $_REQUEST["req_discount_amt"]    = getPrice($_REQUEST["req_discount_amt"]);
   $_REQUEST["req_caja_impresa"]    = trim(addslashes($_REQUEST["req_caja_impresa"]));
   $_REQUEST["req_tipo_moi"]        = trim(addslashes($_REQUEST["req_tipo_moi"]));
   $_REQUEST["req_medida_de_caja"]  = trim(addslashes($_REQUEST["req_medida_de_caja"]));
   $_REQUEST["req_cubicaje"]        = trim(addslashes($_REQUEST["req_cubicaje"]));
   $_REQUEST["fab_cod_pro_dis_version"] = trim(addslashes($_REQUEST["fab_cod_pro_dis_version"]));
   //----------------------------------------------------------------------------------
   $_REQUEST["req_crtdat"]          = explode(".", $_REQUEST["req_crtdat"]);
   $_REQUEST["req_crtdat"]          = (int)mktime(date('H'), date('i'), date('s'), $_REQUEST["req_crtdat"][1], $_REQUEST["req_crtdat"][0], $_REQUEST["req_crtdat"][2]);
   $_REQUEST["req_oc_dat"]          = explode(".", $_REQUEST["req_oc_dat"]);
   $_REQUEST["req_oc_dat"]          = (int)mktime(date('H'), date('i'), date('s'), $_REQUEST["req_oc_dat"][1], $_REQUEST["req_oc_dat"][0], $_REQUEST["req_oc_dat"][2]);
   $_REQUEST["req_fec_despacho"]    = (int)$_REQUEST["req_fec_despacho"];

      /* Envio informacion a CRM */
   
   if($_REQUEST["req_status"] == 2)
   {
      $sql       = "select * from customer where id = '{$headdata["req_cust_id"]}'";
 
      $idcliente = $CON->select($sql);
      $idcliente = $idcliente[0];
      $idcrm     = $idcliente['cust_id_crm'];

      $sql         = "select * from parametros where tabla = 'CANAL' and codigo = {$idcliente["cust_canal"]}";
      $canal       = $CON->select($sql);
      $canal       = $canal[0];
      $canal       = $canal["descripcion"];

      $sql       = "select min(item_sellprice_netto_dsc) as monto from offers_items where req_id = {$_REQUEST["id"]}";
      $monto     = $CON->select($sql);
      $monto     = $monto[0]['monto'];

      $sql        = "select nombre from comunas where id = {$idcliente['cust_comunaid']}";
      $comunas    = $CON->select($sql);
