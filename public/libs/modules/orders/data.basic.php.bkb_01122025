               <script>
                     function mostrarImagen(select) 
                     {
                        let img = document.getElementById("preview");
                        let inputHash = document.getElementById("fab_design_imagehash_hidden");
                        let selectedOption = select.options[select.selectedIndex];
                        let imgSrc = selectedOption.getAttribute("data-img");

                        if (imgSrc) {
                           img.src = "./docs.tran/versiones/" + imgSrc;
                           img.style.display = "block";
                           inputHash.value = imgSrc; // Guarda el nombre del archivo en el input oculto
                        } else {
                           img.style.display = "none";
                           inputHash.value = ""; // Limpia el valor si no hay imagen
                        }
                     }

                     function mostrarImagen2(select)
                     {
                        let img = document.getElementById("preview2");
                        let inputHash = document.getElementById("fab_design_imagehash_hidden");
                        let selectedOption = select.options[select.selectedIndex]; // Obtiene la opción seleccionada
                        let imgSrc = selectedOption.getAttribute("data-img"); // Obtiene la imagen asociada
                        if (imgSrc) {
                            img.src = "./docs.tran/versiones/" + imgSrc; // Ajusta la ruta donde están las imágenes
                            img.style.display = "block"; // Muestra la imagen
                            inputHash.value = imgSrc; // Guarda el nombre del archivo en el input oculto
                         } else {
                            img.style.display = "none"; // Oculta si no hay selección
                            inputHash.value = ""; // Limpia el valor si no hay imagen
                         }
                     }

                     function mostrarTD(valor) 
                     {
                        if (valor === "Si") {
                           document.getElementById("tdCliente").style.display = "table-cell";
                           document.getElementById("tdGenerico").style.display = "none";
                           document.getElementById("tdClienteI").style.display = "table-cell";
                           document.getElementById("tdGenericoI").style.display = "none";
                        } else {
                           document.getElementById("tdCliente").style.display = "none";
                           document.getElementById("tdGenerico").style.display = "table-cell";
                           document.getElementById("tdClienteI").style.display = "none";
                           document.getElementById("tdGenericoI").style.display = "table-cell";

                        }
                     }

                     function MostarDatosPantalla(select)
                     {
                        const selectedOption = select.options[select.selectedIndex];
                        const manilla = selectedOption.getAttribute('data-color-manilla');
                        const tela    = selectedOption.getAttribute('data-color-tela'); 
                        const barra   = selectedOption.getAttribute('data-codigo-barra');
                        const tipop   = selectedOption.getAttribute('data-tipo-print'); 
                        const alto    = selectedOption.getAttribute('data-print-alto'); 
                        const ancho   = selectedOption.getAttribute('data-print-ancho');
                        
                       

                        for (let i = 1; i <= 10; i++) {
                           const index = String(i).padStart(2, '0'); // "01", "02", ..., "10"
                           const color = selectedOption.getAttribute(`data-color${index}`);
                           const front = selectedOption.getAttribute(`data-print-frente${index}`);
                           const back  = selectedOption.getAttribute(`data-print-dorso${index}`);

                           // Descripción del color
                           const descInput = document.getElementById(`fab_print_colordesc_${i}`);
                           if (descInput && color !== null) {
                              descInput.value = color;
                           }

                           // Checkbox Frente
                           const frontCheckbox = document.getElementById(`fab_print_colors_front_${i}`);
                           if (frontCheckbox && front !== null) {
                              frontCheckbox.checked = front === "1";
                           }

                           // Hidden Frente
                           const frontHidden = document.getElementById(`fab_print_colors_front_hidden${i}`);
                           if (frontHidden && front !== null) {
                              frontHidden.value = front;
                           }

                           // Checkbox Dorso
                           const backCheckbox = document.getElementById(`fab_print_colors_back_${i}`);
                           if (backCheckbox && back !== null) {
                              backCheckbox.checked = back === "1";
                           }

                           // Hidden Dorso
                           const backHidden = document.getElementById(`fab_print_colors_back_hidden${i}`);
                           if (backHidden && back !== null) {
                              backHidden.value = back;
                           }
                        }                        

                        document.getElementById('fab_printtype').value = tipop;
                        document.getElementById('fab_print_width').value = ancho;
                        document.getElementById('fab_print_height').value = alto;
                        document.getElementById('fab_mat_manilla_color').value = manilla;
                        document.getElementById('fab_mat_fabric_color').value = tela;
                        document.getElementById('item_sellprice_barcodenumber_0').value = barra;
                        document.getElementById('fab_mat_manilla_color_hidden').value = document.getElementById('fab_mat_manilla_color').value;
                        document.getElementById('fab_mat_fabric_color_hidden').value = document.getElementById('fab_mat_fabric_color').value;
                        document.getElementById('fab_mat_fabric_color_hidden').value = document.getElementById('fab_mat_fabric_color').value;
                     }
               </script>
               <?
            }
            ?>
         </table>         
