            <td class="content_row_os" align="center">
               <select style="width:65px;" class="clsselamts_sel text" id="selamt_<?=$data[$x]["id"]?>">
                  <option value=""></option>
                  <?
                  foreach($prices AS $price)
                  {  ?>
                     <option value="<?=(int)$price["prc_amount"]?>"><?=printPrice($price["prc_amount"])?></option>
                     <?
