//----------------------------------------------------------------------------------
elseif($_REQUEST["exec"] == "save")
{
   foreach($_REQUEST["preids"] AS $xpreidsarr)
   {
      $xpreidsarr = explode("-", $xpreidsarr);
      $_REQUEST["preid"] = $xpreidsarr[0];
      $_REQUEST["xamt"]  = $xpreidsarr[1];
      
      $sql = " select *
               from price_lists_fab_items_predefines
               where
               id = {$_REQUEST["preid"]}";
      $predefine = $CON->select($sql);
      $predefine = $predefine[0];

      $sql = " select *
               from item
               where
               id = {$_REQUEST["itemid"]}";
      $itemdata = $CON->select($sql);
      $itemdata = $itemdata[0];

      $sql = " select *
               from price_lists_fab_items
               where
               id = {$predefine["header_id"]}";
      $medida = $CON->select($sql);
      $medida = $medida[0];

      $sql = " select MAX(item_pos) 'max_item_pos'
               from offers_items
               where
               req_id = {$_REQUEST["id"]}";
      $max_item_pos = $CON->select($sql);
      if($max_item_pos[0]["max_item_pos"] != "")
         $max_item_pos = $max_item_pos[0]["max_item_pos"] + 1;
      else
         $max_item_pos = 0;

      //----------------------------------------------------------------------------------
      $item_amount      = (int)$_REQUEST["xamt"];
      $sql_sellprice    = 0.00;
      $sql_taxesperc    = 0.00;
      $sql_sellnetto    = 0.00;
      $sql_taxes        = 0.00;
      $fab_print_width     = (int)$medida["fab_print_width"];
      $fab_print_height    = (int)$medida["fab_print_height"];

      //----------------------------------------------------------------------------------
      for($x = 1; $x <= 20; $x++)
         unset($_REQUEST["fab_print_colors_front_{$x}"]);
      for($x = 1; $x <= 20; $x++)
         unset($_REQUEST["fab_print_colors_back_{$x}"]);

      //----------------------------------------------------------------------------------
      for($x = 1; $x <= $predefine["fab_print_colors_front"]; $x++)
         $_REQUEST["fab_print_colors_front_{$x}"]  = 1;
      for($x = 1; $x <= $predefine["fab_print_colors_back"]; $x++)
         $_REQUEST["fab_print_colors_back_{$x}"]  = 1;

      //----------------------------------------------------------------------------------
      $_FRONT_COLORS    = 0;
      $_BACK_COLORS     = 0;
      $_COLORS_2SIDES   = 0;
      $_COLORS_1SIDES   = 0;
      foreach(array_keys($_REQUEST) AS $reqkey)
      {
         if(strpos($reqkey, "fab_print_colors_front_") !== false && strpos($reqkey, "fab_print_colors_front_") == 0)
         {
            $idx = substr($reqkey, strrpos($reqkey, "_") +1);
            if((int)$_REQUEST["fab_print_colors_front_{$idx}"] && (int)$_REQUEST["fab_print_colors_back_{$idx}"])
               $_COLORS_2SIDES++;
            else
               $_COLORS_1SIDES++;

            $_FRONT_COLORS++;
         }
         if(strpos($reqkey, "fab_print_colors_back_") !== false && strpos($reqkey, "fab_print_colors_back_") == 0)
         {
            $idx = substr($reqkey, strrpos($reqkey, "_") +1);

            if((int)$_REQUEST["fab_print_colors_back_{$idx}"] && !(int)$_REQUEST["fab_print_colors_front_{$idx}"])
               $_COLORS_1SIDES++;

            $_BACK_COLORS++;
         }
      }
      $_ROW_COLORS_1SIDES = $_COLORS_1SIDES;
      $_ROW_COLORS_2SIDES = $_COLORS_2SIDES;

      //----------------------------------------------------------------------------------
      $item_img      = $itemdata["item_img"];
      $new_item_img  = "";
      if($item_img != "")
      {
         $new_item_img = $_REQUEST["id"]."_".md5(microtime()).$item_img;
         copy("{$_SESSION["_CONF"]["conf_shopadmin_path"]}images/items/{$item_img}", "{$_SESSION["_CONF"]["conf_shopadmin_path"]}docs.offer/{$new_item_img}");
      }

      if($itemdata["item_des_personalizada"]==0)
      {
            //----------------------------------------------------------------------------------
            $item_compdesc = "<b>{$itemdata["item_fabricate_prefix"]} modelo {$itemdata["item_title"]}</b>";

            $omitFabDesc = false;
            if($itemdata["item_fabricate_fabrictext"] != "")
            {
               $item_compdesc .= " {$itemdata["item_fabricate_fabrictext"]}, medidas ";
               $omitFabDesc = true;
            }

            if(!$omitFabDesc)
            {
               $sql = " select fabt_desc
                        from fabric_types
                        where
                        fabt_status > 0 and
                        fabt_code   = '{$medida["fab_type"]}'";
               $fabt_desc = $CON->select($sql);
               $fabt_desc = $fabt_desc[0]["fabt_desc"];

               if($fabt_desc != "")
                  $item_compdesc .= " {$fabt_desc}, color a elección, medidas ";
               else
                  $item_compdesc .= " color a elección, medidas ";
            }
      
            $fulle_addtxt = "";
            if($itemdata["item_fabricate_fuelletext"] != "")
               $fulle_addtxt = " {$itemdata["item_fabricate_fuelletext"]}";
      
            $item_compdesc .= "<b>".(int)$predefine["fab_med_width"]."cm (ancho) x ".(int)$predefine["fab_med_height"]."cm (alto) ";
            if((int)$predefine["fab_med_fuelle"])
               $item_compdesc .= "x ".(int)$predefine["fab_med_fuelle"]."cm (fuelle{$fulle_addtxt})";
            $item_compdesc .= "</b>, ";

            if((int)$medida["fab_manilla_length"])
               $item_compdesc .= "con manillas de largo ".(int)$medida["fab_manilla_length"]." cm de color a elección, ";

            $item_compdesc .= "impresión por ";
         
            if($predefine["fab_printtype"] == "FLEX")
               $item_compdesc .= "Flexografía";
            elseif($predefine["fab_printtype"] == "SERI")
               $item_compdesc .= "Serigrafía";

            $_x_item_compdesc = " a {$predefine["fab_print_colors_front"]}/{$predefine["fab_print_colors_back"]} colores.";
            if((int)$predefine["fab_print_colors_front"] == (int)$predefine["fab_print_colors_back"] && (int)$predefine["fab_print_colors_front"] > 0)
            {
               if((int)$predefine["fab_print_colors_front"] == 1)
                  $_x_item_compdesc = " a ".$_LANG["MODULE"]["OFFERNUMS"][(int)$predefine["fab_print_colors_front"]]." color, ambos lados.";
               else
                  $_x_item_compdesc = " a ".$_LANG["MODULE"]["OFFERNUMS"][(int)$predefine["fab_print_colors_front"]]." colores, ambos lados.";
            }
            elseif((int)$predefine["fab_print_colors_front"] > (int)$predefine["fab_print_colors_back"] && (int)$predefine["fab_print_colors_back"] == 0)
            {
               if((int)$predefine["fab_print_colors_front"] == 1)
                  $_x_item_compdesc = " a ".$_LANG["MODULE"]["OFFERNUMS"][(int)$predefine["fab_print_colors_front"]]." color, un lado.";
               else
                  $_x_item_compdesc = " a ".$_LANG["MODULE"]["OFFERNUMS"][(int)$predefine["fab_print_colors_front"]]." colores, un lado.";
            }
            $item_compdesc .= $_x_item_compdesc;

            $pos_incid = $medida["fab_inc_id"];
            $fab_noprint_discount = $medida["fab_noprint_discount"];
      }
      else
      {
         $lin = "\n";
         $item_compdesc = "<b>{$itemdata["item_title"]}</b>".$lin.$lin;;
         $item_compdesc .= "{$itemdata["item_desc"]}";
      }
               
      //----------------------------------------------------------------------------------
      if((int)$headdata["req_prices_cnt"] <= 1)
      {
         $sql = " select *
                  from price_lists_fab_amounts
                  where
                  pl_id       = {$headdata["req_plid_fab"]} and
                  amt_status  > 0 and
                  amt_val     = {$item_amount}";
         $amt_dsc = $CON->select($sql);
         $amt_dsc = (float)$amt_dsc[0]["amt_dsc"];

         $sql = " select prc_price
                  from price_lists_fab_items_prices
                  where
                  pl_id          = {$headdata["req_plid_fab"]} and
                  prc_headerid   = {$medida["id"]} and
                  prc_amount     = {$item_amount} ";
         $prc_price_base = $CON->select($sql);
         $prc_price_base = $prc_price_base[0]["prc_price"];

         $sql = " select *
                  from price_lists_fab_increments_pos
                  where
                  pl_id       = {$headdata["req_plid_fab"]} and
                  pos_amount  = {$item_amount} and
                  pos_incid   = {$pos_incid}";
         $increment = $CON->select($sql);
         $increment = $increment[0];

         $incrval = 0;
         if(!(int)$_ROW_COLORS_1SIDES && !(int)$_ROW_COLORS_2SIDES)
            $incrval = $fab_noprint_discount * -1;
         else
         {
            if($predefine["fab_printtype"] == "FLEX")
            {
               if($_ROW_COLORS_2SIDES > 0)
                  $_ROW_COLORS_2SIDES--;
               elseif($_ROW_COLORS_1SIDES > 0)
                  $_ROW_COLORS_1SIDES--;

               if($_ROW_COLORS_2SIDES > 0)
                  $incrval += ($_ROW_COLORS_2SIDES * $increment["aum_prc_flexo_2sides"]);
               if($_ROW_COLORS_1SIDES > 0)
                  $incrval += ($_ROW_COLORS_1SIDES * $increment["aum_prc_flexo_1sides"]);
            }
            elseif($predefine["fab_printtype"] == "SERI")
            {
               if($_ROW_COLORS_2SIDES > 0)
               {
                  $_ROW_COLORS_2SIDES--;
                  $_ROW_COLORS_1SIDES++;
               }
               elseif($_ROW_COLORS_1SIDES > 0)
                  $_ROW_COLORS_1SIDES--;

               if($_ROW_COLORS_2SIDES > 0)
                  $incrval += ($_ROW_COLORS_2SIDES * 2 * $increment["aum_prc_seri_1sides"]);
               if($_ROW_COLORS_1SIDES > 0)
                  $incrval += ($_ROW_COLORS_1SIDES * $increment["aum_prc_seri_1sides"]);
            }
         }

         if($amt_dsc > 0.00)
         {
            if((int)$_COLORS_1SIDES == 0 && (int)$_COLORS_2SIDES == 0)
               $incrval -= $amt_dsc;
         }

         $itemunitprice    =  $prc_price_base + $incrval;
         $itemtotalprice   = $item_amount * $itemunitprice;

         $sql_sellnetto = (int)$itemunitprice;
         $sql_taxesperc = $_SESSION["_CONF"]["conf_taxes"];
         $sql_taxes     = round($sql_sellnetto / 100 * $sql_taxesperc);
         $sql_sellprice = $sql_sellnetto + $sql_taxes;

         for($x = 1; $x <= 5; $x++)
         {
            $_REQUEST["fab_print_colors_front_{$x}"]  = (int)$_REQUEST["fab_print_colors_front_{$x}"];
            $_REQUEST["fab_print_colors_back_{$x}"]   = (int)$_REQUEST["fab_print_colors_back_{$x}"];
         }
         
         //----------------------------------------------------------------------------------
         $sql = " insert into offers_items
                  (req_id, item_id, item_pos, item_amount, item_type, item_sellprice_brutto,
                   item_sellprice_taxes_perc, item_sellprice_netto, item_sellprice_taxes, item_desc,
                   item_sellprice_netto_ccval1, item_sellprice_netto_ccval2, item_sellprice_netto_ccval3,
                   item_sellprice_netto_ccval4, item_sellprice_netto_ccval5, item_compdesc,
                   fab_type, fab_printtype, fab_med_width, fab_med_height, fab_med_fuelle, fab_print_width,
                   fab_print_height, fab_manilla_length, fab_mat_fabric_color, fab_mat_manilla_color, fab_print_colors_front_1,
                   fab_print_colors_back_1, fab_print_colors_front_2, fab_print_colors_back_2, fab_print_colors_front_3,
                   fab_print_colors_back_3, fab_print_colors_front_4, fab_print_colors_back_4, fab_print_colors_front_5,
                   fab_print_colors_back_5, item_img_hash)
                  VALUES
                  ({$_REQUEST["id"]}, {$_REQUEST["itemid"]}, {$max_item_pos}, {$item_amount}, 'item',
                   {$sql_sellprice}, {$sql_taxesperc}, {$sql_sellnetto}, {$sql_taxes}, '',
                   0, 0, 0, 0, 0, '{$item_compdesc}',
                   '{$medida["fab_type"]}', '{$predefine["fab_printtype"]}',
                   {$predefine["fab_med_width"]}, {$predefine["fab_med_height"]}, {$predefine["fab_med_fuelle"]},
                   {$fab_print_width}, {$fab_print_height}, {$medida["fab_manilla_length"]},
                   0, 0,
                   {$_REQUEST["fab_print_colors_front_1"]}, {$_REQUEST["fab_print_colors_back_1"]},
                   {$_REQUEST["fab_print_colors_front_2"]}, {$_REQUEST["fab_print_colors_back_2"]},
                   {$_REQUEST["fab_print_colors_front_3"]}, {$_REQUEST["fab_print_colors_back_3"]},
                   {$_REQUEST["fab_print_colors_front_4"]}, {$_REQUEST["fab_print_colors_back_4"]},
                   {$_REQUEST["fab_print_colors_front_5"]}, {$_REQUEST["fab_print_colors_back_5"]},
                   '{$new_item_img}')";
         $CON->no_result($sql);

         recalcOrderItem($CON, $_REQUEST["id"], $_REQUEST["itemid"], $max_item_pos, true, "OFFER");
         recalcOrder($CON, $_REQUEST["id"], "OFFER");
      }
      else
      {
         //----------------------------------------------------------------------------------
         $_PRICESSQL["item_sellprice_netto_ccval1"] = 0;
         $_PRICESSQL["item_sellprice_netto_ccval2"] = 0;
         $_PRICESSQL["item_sellprice_netto_ccval3"] = 0;
         $_PRICESSQL["item_sellprice_netto_ccval4"] = 0;
         $_PRICESSQL["item_sellprice_netto_ccval5"] = 0;

         //----------------------------------------------------------------------------------
         for($xx = 1; $xx <= $headdata["req_prices_cnt"]; $xx++)
         {
            if($headdata["req_prices_ccval{$xx}"] > 0)
            {
               $item_amount = (int)$headdata["req_prices_ccval{$xx}"];
               $_ROW_COLORS_1SIDES = $_COLORS_1SIDES;
               $_ROW_COLORS_2SIDES = $_COLORS_2SIDES;

               $sql = " select *
                        from price_lists_fab_amounts
                        where
                        pl_id       = {$headdata["req_plid_fab"]} and
                        amt_status  > 0 and
                        amt_val     = {$item_amount}";
               $amt_dsc = $CON->select($sql);
               $amt_dsc = (float)$amt_dsc[0]["amt_dsc"];

               $sql = " select prc_price
                        from price_lists_fab_items_prices
                        where
                        pl_id          = {$headdata["req_plid_fab"]} and
                        prc_headerid   = {$medida["id"]} and
                        prc_amount     = {$item_amount} ";
               $prc_price_base = $CON->select($sql);
               $prc_price_base = $prc_price_base[0]["prc_price"];

               $sql = " select *
                        from price_lists_fab_increments_pos
                        where
                        pl_id       = {$headdata["req_plid_fab"]} and
                        pos_amount  = {$item_amount} and
                        pos_incid   = {$pos_incid}";
               $increment = $CON->select($sql);
               $increment = $increment[0];

               $incrval = 0;
               if(!(int)$_ROW_COLORS_1SIDES && !(int)$_ROW_COLORS_2SIDES)
                  $incrval = $fab_noprint_discount * -1;
               else
               {
                  if($predefine["fab_printtype"] == "FLEX")
                  {
                     if($_ROW_COLORS_2SIDES > 0)
                        $_ROW_COLORS_2SIDES--;
                     elseif($_ROW_COLORS_1SIDES > 0)
                        $_ROW_COLORS_1SIDES--;

                     if($_ROW_COLORS_2SIDES > 0)
                        $incrval += ($_ROW_COLORS_2SIDES * $increment["aum_prc_flexo_2sides"]);
                     if($_ROW_COLORS_1SIDES > 0)
                        $incrval += ($_ROW_COLORS_1SIDES * $increment["aum_prc_flexo_1sides"]);
                  }
                  elseif($predefine["fab_printtype"] == "SERI")
                  {
                     if($_ROW_COLORS_2SIDES > 0)
                     {
                        $_ROW_COLORS_2SIDES--;
                        $_ROW_COLORS_1SIDES++;
                     }
                     elseif($_ROW_COLORS_1SIDES > 0)
                        $_ROW_COLORS_1SIDES--;

                     if($_ROW_COLORS_2SIDES > 0)
                        $incrval += ($_ROW_COLORS_2SIDES * 2 * $increment["aum_prc_seri_1sides"]);
                     if($_ROW_COLORS_1SIDES > 0)
                        $incrval += ($_ROW_COLORS_1SIDES * $increment["aum_prc_seri_1sides"]);
                  }
               }

               if($amt_dsc > 0.00)
               {
                  if((int)$_COLORS_1SIDES == 0 && (int)$_COLORS_2SIDES == 0)
                     $incrval -= $amt_dsc;
               }

               $itemunitprice    = $prc_price_base + $incrval;
               $itemtotalprice   = $item_amount * $itemunitprice;

               $_PRICESSQL["item_sellprice_netto_ccval{$xx}"] = $itemunitprice;
            }
         }

         //----------------------------------------------------------------------------------
         for($x = 1; $x <= 5; $x++)
         {
            $_REQUEST["fab_print_colors_front_{$x}"]  = (int)$_REQUEST["fab_print_colors_front_{$x}"];
            $_REQUEST["fab_print_colors_back_{$x}"]   = (int)$_REQUEST["fab_print_colors_back_{$x}"];
         }

         //----------------------------------------------------------------------------------
         $sql_taxesperc = $_SESSION["_CONF"]["conf_taxes"];
         $sql = " insert into offers_items
                  (req_id, item_id, item_pos, item_amount, item_type, item_sellprice_brutto,
                   item_sellprice_taxes_perc, item_sellprice_netto, item_sellprice_taxes, item_desc,
                   item_sellprice_netto_ccval1, item_sellprice_netto_ccval2, item_sellprice_netto_ccval3,
                   item_sellprice_netto_ccval4, item_sellprice_netto_ccval5, item_compdesc,
                   fab_type, fab_printtype, fab_med_width, fab_med_height, fab_med_fuelle, fab_print_width,
                   fab_print_height, fab_manilla_length, fab_mat_fabric_color, fab_mat_manilla_color, fab_print_colors_front_1,
                   fab_print_colors_back_1, fab_print_colors_front_2, fab_print_colors_back_2, fab_print_colors_front_3,
                   fab_print_colors_back_3, fab_print_colors_front_4, fab_print_colors_back_4, fab_print_colors_front_5,
                   fab_print_colors_back_5, item_img_hash)
                  VALUES
                  ({$_REQUEST["id"]}, {$_REQUEST["itemid"]}, {$max_item_pos}, {$item_amount}, 'item',
                   0, {$sql_taxesperc}, 0, 0, '',
                   {$_PRICESSQL["item_sellprice_netto_ccval1"]},
                   {$_PRICESSQL["item_sellprice_netto_ccval2"]},
                   {$_PRICESSQL["item_sellprice_netto_ccval3"]},
                   {$_PRICESSQL["item_sellprice_netto_ccval4"]},
                   {$_PRICESSQL["item_sellprice_netto_ccval5"]},
                   '{$item_compdesc}',
                   '{$medida["fab_type"]}', '{$predefine["fab_printtype"]}',
                   {$predefine["fab_med_width"]}, {$predefine["fab_med_height"]}, {$predefine["fab_med_fuelle"]},
                   {$fab_print_width}, {$fab_print_height}, {$medida["fab_manilla_length"]},
                   0, 0,
                   {$_REQUEST["fab_print_colors_front_1"]}, {$_REQUEST["fab_print_colors_back_1"]},
                   {$_REQUEST["fab_print_colors_front_2"]}, {$_REQUEST["fab_print_colors_back_2"]},
                   {$_REQUEST["fab_print_colors_front_3"]}, {$_REQUEST["fab_print_colors_back_3"]},
                   {$_REQUEST["fab_print_colors_front_4"]}, {$_REQUEST["fab_print_colors_back_4"]},
                   {$_REQUEST["fab_print_colors_front_5"]}, {$_REQUEST["fab_print_colors_back_5"]},
                   '{$new_item_img}')";
         $CON->no_result($sql);
         
         recalcOrderItem($CON, $_REQUEST["id"], $_REQUEST["itemid"], $max_item_pos, true, "OFFER");
         recalcOrder($CON, $_REQUEST["id"], "OFFER");
      }
   }
   ?>
   <script language="JavaScript">
      parent.location.href = '/index.php?mid=770&exec=edit&subcatexec=basic&id=<?=$_REQUEST["id"]?>';
   </script>
