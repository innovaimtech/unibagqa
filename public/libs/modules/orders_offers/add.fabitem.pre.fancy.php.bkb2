{
   $_REQUEST["sql_xtext"] = trim(addslashes($_REQUEST["sql_xtext"]));
   $_REQUEST["sql_xcode"] = trim(addslashes($_REQUEST["sql_xcode"]));
   
   $sql = " select distinct t2.id, t2.item_number_prod, t2.item_title
            from price_lists_fab_items t1
            INNER JOIN item t2 ON t1.fab_item_id = t2.id
            INNER JOIN price_lists_fab_items_predefines t3 ON t1.id = t3.header_id
            where
            t1.pl_id       = {$headdata["req_plid_fab"]} and
            t1.fab_active  = 1 ";
   if($_REQUEST["sql_xtext"] != "")
      $sql .= " and t2.item_title like '%{$_REQUEST["sql_xtext"]}%' ";
   if($_REQUEST["sql_xcode"] != "")
      $sql .= " and t2.item_number_prod like '%{$_REQUEST["sql_xcode"]}%' ";
   $sql .= " order by t2.item_title, t2.item_number_prod";
   $items = $CON->select($sql);
