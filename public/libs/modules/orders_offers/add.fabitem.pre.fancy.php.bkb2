elseif($_REQUEST["exec"] == "")
{
   $sql = " select t4.*, t2.item_title, t2.item_number_prod, t3.inc_name, t1.fab_desc, t1.fab_type
            from price_lists_fab_items t1
            LEFT OUTER JOIN item t2                         ON t1.fab_item_id = t2.id
            LEFT OUTER JOIN price_lists_fab_increments t3   ON t1.fab_inc_id = t3.id
            INNER JOIN price_lists_fab_items_predefines t4  ON t1.id = t4.header_id
            where
            t1.pl_id          = {$headdata["req_plid_fab"]} and
            t1.fab_item_id    = {$_REQUEST["itemid"]}
            order by t1.fab_type, t4.fab_printtype, t4.fab_print_colors_front, t4.fab_print_colors_back,
            t1.fab_desc, t2.item_title, t1.fab_item_id, t1.id,  t4.fab_med_width";
   $data = $CON->select($sql);
   $colspan = 10;
   if((int)$headdata["req_prices_cnt"] <= 1)
      $colspan = 11;
   ?>
   <script language="JavaScript">
   function setFabPreItem(preid)
   {
      var xamt = parseInt($('#selamt_' +preid).val());

      if(xamt > 0)
      {
         location.href = 'iframe.fancy.php?exec=save&module=<?=$_REQUEST["module"]?>&id=<?=$_REQUEST["id"]?>&itemid=<?=$_REQUEST["itemid"]?>' +'&preids[]=' +preid +'-' +xamt;
      }
   }
   function setFabPreItemMulti()
   {
      var hasdata  = false;
      var baselink = 'iframe.fancy.php?exec=save&module=<?=$_REQUEST["module"]?>&id=<?=$_REQUEST["id"]?>&itemid=<?=$_REQUEST["itemid"]?>';
      $('.clsselamts_chk').each(function()
      {
         if($(this).attr('checked'))
         {
            var objid = $(this).attr('id').split('_');
            objid = objid[1];
            baselink = baselink +'&preids[]=' +objid +'-' +$(this).val();
            hasdata = true;
         }
      });

      $('.clsselamts_sel').each(function()
      {
         if(parseInt($(this).val()) > 0)
         {
            var objid = $(this).attr('id').split('_');
            objid = objid[1];
            baselink = baselink +'&preids[]=' +objid +'-' +parseInt($(this).val());
            hasdata = true;
         }
      });

      if(hasdata)
         location.href = baselink;
   }
   </script>
