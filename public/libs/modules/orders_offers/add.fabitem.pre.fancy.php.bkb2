         -->
      </tr>
      <?
   }
   if(!$x)
   {  ?>
      <tr bgcolor="<?=getRowColor(0)?>">
         <td class="content_row" colspan="<?=$colspan?>" align="center" valign="middle" height="30">
            <br>
            <b class="msg_save_err">No hay datos disponibles.</b>
            <br><br>
         </td>
      </tr>
      <?
   }
   ?>
   </table>
   <?=Nifty_printF()?>
