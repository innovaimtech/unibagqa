         <td class="content_tbl_header"><?=printSortLink($_sesmodulename, $_sortlinks, 4)?></td>
         <td class="content_tbl_header"><?=printSortLink($_sesmodulename, $_sortlinks, 5)?></td>
         <td class="content_tbl_header"><?=printSortLink($_sesmodulename, $_sortlinks, 8)?></td>
         <td class="content_tbl_header"><?=printSortLink($_sesmodulename, $_sortlinks, 9)?></td>
         
      </tr>
      <?
      //----------------------------------------------------------------------------------
      for($x = 0; $x < count($clients) && $clients != false; $x++)
      {  ?>
         <tr bgcolor="<?=getRowColor($x)?>" onmouseover="mark(this, 0)" onmouseout="mark(this,1)">
            <td class="content_row_os"><nobr><?=$clients[$x]["cust_rut"]?></nobr></td>
            <td class="content_row_os"><nobr><?=$clients[$x]["cust_company"]?></nobr></td>
            <td class="content_row_os"><nobr><?=$clients[$x]["cust_street"]?>&nbsp;</nobr></td>
            <td class="content_row_os"><nobr><?=$clients[$x]["cust_phone"]?>&nbsp;</nobr></td>
            <td class="content_row_os"><nobr><?=$clients[$x]["cust_email"]?>&nbsp;</nobr></td>
            <td class="content_row_os"><nobr><?=$clients[$x]["name"]?>&nbsp;</nobr></td>
            <td class="content_row_os"><nobr><?=$clients[$x]["nombre"]?>&nbsp;</nobr></td>
            <td class="content_row_os"><nobr><?=$clients[$x]["user_firstname"]?>&nbsp;<?=$clients[$x]["user_lastname"]?></nobr></td>
            <td class="content_row_os"><nobr><?=$clients[$x]["cat_name"]?>&nbsp;</nobr></td>
            <td class="content_row_os"><nobr><?=$clients[$x]["canal"]?>&nbsp;</nobr></td>
         </tr>
         <?
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cust_rut"]     = $clients[$x]["cust_rut"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cust_company"] = $clients[$x]["cust_company"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cust_name"]    = $clients[$x]["cust_name"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cust_street"]  = $clients[$x]["cust_street"];

         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cust_cellphone"] = $clients[$x]["cust_cellphone"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cust_fax"]       = $clients[$x]["cust_fax"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cust_website"]   = $clients[$x]["cust_website"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["pro_name"]       = $clients[$x]["pro_name"];

         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cust_pricetolerance"]  = $clients[$x]["cust_pricetolerance"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cust_convenio_act"]    = $clients[$x]["cust_convenio_act"];

         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["giro_name"]    = $clients[$x]["giro_name"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["trans_name"]    = $clients[$x]["trans_name"];


         if($clients[$x]["pl_title"] == "")
            $clients[$x]["pl_title"] = "PRECIOS BASICOS";
            
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["pl_title"]    = $clients[$x]["pl_title"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["pay_title"]   = $clients[$x]["pay_title"];

         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["name"]         = $clients[$x]["name"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["nombre"]       = $clients[$x]["nombre"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["username"]     = $clients[$x]["user_firstname"]." ".$clients[$x]["user_lastname"];

         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cust_phone"]   = $clients[$x]["cust_phone"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cust_email"]   = $clients[$x]["cust_email"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["cat_name"]     = $clients[$x]["cat_name"];
         $_SESSION["STATS"][$_sesmodulename]["DATA"][$x]["canal"]        = $clients[$x]["canal"];
      }

      if(!$x)
      {  ?>
         <tr bgcolor="<?=getRowColor(0)?>">
            <td class="content_row" colspan="8" align="center">
               <br>
               <b class="msg_save_err">No hay datos disponibles.</b>
               <br><br>
            </td>
         </tr>
         <?
      }
      ?>
