                     <input type="text" class="inptxt" id="ingresokgamt_<?=$lidx?>" name="ingresokgamt_<?=$lidx?>"
                     style="width:100%;text-align:center" onkeyup="recalcUsedAmt('<?=$lidx?>')"
                     value="<?=printPrice($_REQUEST["ingresokgamt_{$lidx}"],2)?>">
