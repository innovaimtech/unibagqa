APP_ENV=local
APP_TIMEZONE=America/Santiago
SESSION_SAVE_PATH=

ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=3306
ERP_DB_NAME=unibag_unibag
ERP_DB_USER=CHANGE_ME_ERP_DB_USER
ERP_DB_PASS=
ERP_DB_CHARSET=utf8mb4

TRZ_DB_HOST=127.0.0.1
TRZ_DB_PORT=3306
TRZ_DB_NAME=unibag_trazabilidad
TRZ_DB_USER=CHANGE_ME_TRZ_DB_USER
TRZ_DB_PASS=
TRZ_DB_CHARSET=utf8mb4

SCALE_MODE=stub
SCALE_HTTP_URL=http://localhost:8765/weight

PRINT_MODE=none
PRINT_HTTP_URL=http://localhost:8767/print
PRINT_PRINTER_NAME=
PRINT_COPIES=1
PRINT_LANGUAGE=zpl
PRINT_DPI=203
PRINT_LABEL_WIDTH_MM=100
PRINT_LABEL_HEIGHT_MM=70
PRINT_LABEL_GAP_MM=3
PRINT_DIRECTION=0
PRINT_REF_X_DOTS=0
PRINT_REF_Y_DOTS=0
