{
    "name": "unibag/erp-trazabilidad",
    "description": "Plataforma Unibag ERP, Producción en Planta, Recepción con Balanza/Impresión Térmica y Trazabilidad",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Unibag\\": "src/"
        },
        "classmap": [
            "src/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

